---
import { Image } from 'astro:assets';
import { siteSettings } from '../config/siteSettings';
import logoImg from '../images/logo.webp';

const { footer, general, header } = siteSettings;
const { content, style } = footer;
---

<footer class="relative overflow-hidden bg-white">
  <!-- CTA Section -->
  <section id="cta" class={`relative ${style.ctaPaddingY} overflow-hidden bg-gradient-to-b from-[#f8f5ee] via-[#faf7f2] to-[#f4eee4]`}>
    <!-- Background Ornamental Top/Bottom Lines -->
    <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-gold/30 to-transparent"></div>
    <div class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-gold/30 to-transparent"></div>

    <!-- Ambient Glow in Background -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-gold/[0.07] rounded-full blur-[120px] pointer-events-none"></div>

    <div class="px-6 md:px-12 lg:px-20 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <!-- Classic Ornament -->
        <div class="cta-reveal flex items-center justify-center gap-4 mb-4 sm:mb-6">
          <span class="w-12 h-px bg-gold/40"></span>
          <span class="font-display text-sm text-gold-dark">{content.ornamentSymbol}</span>
          <span class="w-12 h-px bg-gold/40"></span>
        </div>

        <!-- Heading -->
        <h2 class={`cta-reveal font-display ${style.ctaHeadingSize} font-light tracking-[0.04em] text-slate-900 leading-[1.3] mb-3`}>
          {content.ctaHeading}
        </h2>
        <p class="cta-reveal font-sans text-sm md:text-base lg:text-[17px] font-normal leading-[1.8] tracking-[0.05em] text-slate-700 mb-7 sm:mb-8">
          {content.ctaDescription}
        </p>

        <!-- Phone Number - Matching Heading Size -->
        <div class="cta-reveal">
          <a
            href={general.phoneNumberRaw}
            class="group inline-flex flex-col items-center"
          >
            <!-- TEL Badge -->
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-accent-red text-white font-display text-xs sm:text-sm font-bold tracking-[0.2em] uppercase shadow-sm shadow-accent-red/20 group-hover:bg-accent-red-light transition-colors duration-300 mb-2.5">
              <svg class="w-3 h-3 fill-current shrink-0" viewBox="0 0 24 24">
                <path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 00-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z"/>
              </svg>
              <span>{content.telLabel}</span>
            </span>
            <span class={`font-sans ${style.ctaHeadingSize} font-normal tracking-[0.05em] text-midnight group-hover:text-accent-red transition-colors duration-500 leading-tight`}>
              {general.phoneNumber}
            </span>
            <span class="w-0 group-hover:w-full h-px bg-accent-red/50 transition-all duration-500 mt-2.5"></span>
          </a>
        </div>

        <!-- Hours -->
        <div class="cta-reveal mt-5 sm:mt-6 flex items-center justify-center gap-3">
          <span class="font-sans text-base sm:text-lg md:text-xl font-medium tracking-[0.05em] text-slate-700">
            {general.hours}（{general.holiday}）
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer Info Grid -->
  <div class="border-t border-slate-200 pt-16 pb-12 px-6 md:px-12 lg:px-20 bg-[#f0f4f9]/90">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-12 justify-items-start md:justify-items-center">
      
      <!-- Company/Shop details -->
      <div class="flex flex-col items-start text-left gap-3.5 w-full md:w-auto min-w-[220px]">
        <div class="h-14 flex items-center justify-start">
          <Image
            src={logoImg}
            alt={general.companyName}
            class="h-12 md:h-14 w-auto object-contain transition-opacity duration-300 hover:opacity-90 drop-shadow-sm"
            quality={100}
          />
        </div>
        <p class="font-sans text-sm md:text-base font-medium text-[#2d456b] tracking-widest">
          塩尻市のカーコーティング専門店
        </p>
        <p class="font-sans text-base font-normal text-slate-700 leading-[2.0] tracking-wider">
          カーコーティング<br />
          カーフィルム施工<br />
          プロテクション施工
        </p>
      </div>

      <!-- Info details -->
      <div class="flex flex-col items-start text-left gap-4 w-full md:w-auto min-w-[220px]">
        <h3 class="font-display text-base md:text-lg tracking-[0.22em] text-gold-dark font-bold uppercase h-12 flex items-center justify-start">
          Information
        </h3>
        <address class="font-sans text-base font-normal text-slate-700 leading-[2.0] tracking-wider not-italic">
          {general.zipCode}<br />
          {general.address}<br />
          TEL: <a href={general.phoneNumberRaw} class="text-slate-700 hover:text-slate-950 transition-colors duration-300">{general.phoneNumber}</a><br />
          営業時間: {general.hours}<br />
          定休日: {general.holiday}
        </address>
      </div>

      <!-- Menu links -->
      <div class="flex flex-col items-start text-left gap-4 w-full md:w-auto min-w-[180px]">
        <h3 class="font-display text-base md:text-lg tracking-[0.22em] text-gold-dark font-bold uppercase h-12 flex items-center justify-start">
          Navigation
        </h3>
        <ul class="flex flex-col items-start gap-3.5">
          {header.content.navLinks.map((link) => (
            <li>
              <a href={link.href} class="font-sans text-base font-normal text-slate-700 hover:text-slate-950 transition-colors duration-300">
                {link.labelJa} <span class="text-xs md:text-sm font-display tracking-wider text-[#2d456b] font-semibold uppercase ml-1.5">{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Copyright (Bottom Center) -->
    <div class="mt-16 pt-8 border-t border-slate-200 text-center">
      <p class="font-display text-xs sm:text-sm md:text-base tracking-[0.2em] text-slate-500 font-medium">
        &copy; {new Date().getFullYear()} {content.copyright}
      </p>
    </div>
  </div>
</footer>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray<HTMLElement>('.cta-reveal').forEach((el, i) => {
    gsap.fromTo(el, { opacity: 0, y: 25 }, {
      opacity: 1, y: 0, duration: 0.9, ease: 'power3.out', delay: i * 0.1,
      scrollTrigger: { trigger: el, start: 'top 88%', toggleActions: 'play none none none' },
    });
  });
</script>
