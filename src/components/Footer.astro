---
import { Image } from "astro:assets";
import { siteSettings } from "../config/siteSettings";
import logoImg from "../images/logo.webp";

const { footer, general, header } = siteSettings;
const { content, style } = footer;
---

<footer class="relative overflow-hidden bg-slate-50">
  <!-- CTA Section -->
  <section
    id="cta"
    class={`relative ${style.ctaPaddingY} overflow-hidden bg-gradient-to-b from-[#112340] via-midnight to-[#060e1c] text-white`}
  >
    <!-- Background Ornamental Top/Bottom Lines -->
    <div class="section-border-line top-0"></div>
    <div class="section-border-line bottom-0"></div>

    <!-- Ambient Glow in Background -->
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-brand-blue/[0.12] rounded-full blur-[140px] pointer-events-none"
    >
    </div>
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[200px] bg-gold/[0.08] rounded-full blur-[100px] pointer-events-none"
    >
    </div>

    <div class="px-6 md:px-12 lg:px-20 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <!-- Elegant Section Header Label -->
        <div
          class="cta-reveal flex items-center justify-center gap-5 mb-5 sm:mb-6"
        >
          <span class="w-12 md:w-16 h-px bg-gold/60 flex-shrink-0"></span>
          <span
            class="font-display text-xs sm:text-sm tracking-[0.3em] text-gold uppercase font-bold"
          >
            {content.sectionLabel || "Contact Us"}
          </span>
          <span class="w-12 md:w-16 h-px bg-gold/60 flex-shrink-0"></span>
        </div>

        <!-- Heading -->
        <h2
          class={`cta-reveal font-display ${style.ctaHeadingSize} font-light tracking-[0.04em] text-white leading-[1.3] mb-3`}
        >
          {content.ctaHeading}
        </h2>
        <p
          class="cta-reveal font-sans text-sm md:text-base lg:text-[17px] font-normal leading-[1.8] tracking-[0.05em] text-slate-300 mb-7 sm:mb-8"
        >
          {content.ctaDescription}
        </p>

        <!-- Phone Number Glass Container -->
        <div class="cta-reveal my-2">
          <a
            href={general.phoneNumberRaw}
            class="group inline-flex flex-col items-center px-6 sm:px-10 py-5 sm:py-6 rounded-2xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 hover:border-gold/50 backdrop-blur-md transition-all duration-500 shadow-2xl shadow-black/40 hover:shadow-gold/10 hover:scale-[1.02] active:scale-[0.98]"
          >
            <!-- TEL Badge -->
            <span
              class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-accent-red text-white font-display text-xs sm:text-sm font-bold tracking-[0.2em] uppercase shadow-md shadow-accent-red/30 group-hover:bg-accent-red-light transition-colors duration-300 mb-2.5"
            >
              <svg
                class="w-3.5 h-3.5 fill-current shrink-0"
                viewBox="0 0 24 24"
              >
                <path
                  d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 00-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z"
                ></path>
              </svg>
              <span>{content.telLabel}</span>
            </span>
            <span
              class={`font-sans ${style.ctaHeadingSize} font-normal tracking-[0.05em] text-white group-hover:text-gold-light transition-colors duration-300 leading-tight`}
            >
              {general.phoneNumber}
            </span>
            <span
              class="w-0 group-hover:w-3/4 h-px bg-gold-light/60 transition-all duration-500 mt-2.5"
            ></span>
          </a>
        </div>

        <!-- Hours -->
        <div
          class="cta-reveal mt-5 sm:mt-6 flex items-center justify-center gap-3"
        >
          <span
            class="font-sans text-base sm:text-lg md:text-xl font-medium tracking-[0.05em] text-slate-300"
          >
            {general.hours}（{general.holiday}）
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer Info Grid -->
  <div
    class="border-t border-slate-200 pt-16 pb-12 px-6 md:px-12 lg:px-20 bg-slate-50"
  >
    <div
      class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-12 justify-items-start md:justify-items-center"
    >
      <!-- Company/Shop details -->
      <div
        class="flex flex-col items-start text-left gap-3.5 w-full md:w-auto min-w-[220px]"
      >
        <div class="h-14 flex items-center justify-start">
          <Image
            src={logoImg}
            alt={general.companyName}
            class="h-12 md:h-14 w-auto object-contain transition-opacity duration-300 hover:opacity-90 drop-shadow-sm"
            quality={100}
          />
        </div>
        <p
          class="font-sans text-sm md:text-base font-medium text-[#2d456b] tracking-widest"
        >
          塩尻市のカーコーティング専門店
        </p>
        <p
          class="font-sans text-base font-normal text-slate-700 leading-[2.0] tracking-wider"
        >
          カーコーティング<br />
          カーフィルム施工<br />
          プロテクションフィルム施工
        </p>
      </div>

      <!-- Info details -->
      <div
        class="flex flex-col items-start text-left gap-4 w-full md:w-auto min-w-[220px]"
      >
        <h3
          class="font-display text-base md:text-lg tracking-[0.22em] text-gold-dark font-bold uppercase h-12 flex items-center justify-start"
        >
          Information
        </h3>
        <address
          class="font-sans text-base font-normal text-slate-700 leading-[2.0] tracking-wider not-italic"
        >
          {general.zipCode}<br />
          {general.address}<br />
          TEL: <a
            href={general.phoneNumberRaw}
            class="text-slate-700 hover:text-gold-dark transition-colors duration-300"
            >{general.phoneNumber}</a
          ><br />
          営業時間: {general.hours}<br />
          定休日: {general.holiday}
        </address>
      </div>

      <!-- Menu links -->
      <div
        class="flex flex-col items-start text-left gap-4 w-full md:w-auto min-w-[180px]"
      >
        <h3
          class="font-display text-base md:text-lg tracking-[0.22em] text-gold-dark font-bold uppercase h-12 flex items-center justify-start"
        >
          Navigation
        </h3>
        <ul class="flex flex-col items-start gap-3.5">
          {
            header.content.navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="group inline-flex items-baseline font-sans text-base font-normal text-slate-700 hover:text-slate-900 transition-colors duration-300"
                >
                  <span class="group-hover:text-gold-dark transition-colors duration-300">
                    {link.labelJa}
                  </span>
                  <span class="text-xs md:text-sm font-display tracking-wider text-[#2d456b] font-semibold uppercase ml-1.5 group-hover:text-gold transition-colors duration-300">
                    {link.label}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Copyright & Production Credit -->
    <div
      class="mt-16 pt-8 border-t border-slate-200 text-center flex flex-col sm:flex-row items-center justify-center gap-1.5 sm:gap-3"
    >
      <p
        class="font-display text-xs sm:text-sm md:text-base tracking-[0.2em] text-slate-500 font-medium"
      >
        &copy; {new Date().getFullYear()}
        {content.copyright}
      </p>
      {
        content.creditLabel && content.creditUrl && (
          <div class="flex items-center gap-2">
            <span class="hidden sm:inline text-slate-300">/</span>
            <a
              href={content.creditUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-display text-xs tracking-wider text-slate-400 hover:text-gold-dark transition-colors duration-300"
            >
              {content.creditLabel}
            </a>
          </div>
        )
      }
    </div>
  </div>
</footer>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray<HTMLElement>(".cta-reveal").forEach((el, i) => {
    gsap.fromTo(
      el,
      { opacity: 0, y: 25 },
      {
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: "power3.out",
        delay: i * 0.1,
        scrollTrigger: {
          trigger: el,
          start: "top 88%",
          toggleActions: "play none none none",
        },
      },
    );
  });
</script>
