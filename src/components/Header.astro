---
import { Image } from 'astro:assets';
import { siteSettings } from '../config/siteSettings';
import logoImg from '../images/logo.webp';

const { header, general } = siteSettings;
const { logoText, navLinks, contactLabel, contactLabelJa } = header.content;
---

<header
  id="site-header"
  class="fixed top-0 left-0 w-full z-50 transition-all duration-700 ease-out bg-gradient-to-b from-dark/80 via-dark/40 to-transparent"
>
  <div class="px-6 md:px-12 lg:px-20">
    <div class="max-w-[90rem] mx-auto flex items-center justify-between py-5 md:py-6">
      <!-- Logo -->
      <a href="#" class="relative z-10 group" aria-label={`${general.companyName} Home`}>
        <Image
          src={logoImg}
          alt={general.companyName}
          class="h-10 md:h-12 lg:h-14 w-auto object-contain transition-transform duration-300 group-hover:opacity-90 drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)]"
          quality={100}
        />
      </a>

      <!-- Nav (Desktop) -->
      <nav class="hidden lg:flex items-center gap-10" aria-label="Main navigation">
        {navLinks.map((link) => (
          <a href={link.href} class="nav-link">
            <span class="text-[15px] font-sans tracking-wider text-off-white font-medium">
              {link.labelJa}
            </span>
            <span class="text-[10px] font-display tracking-[0.18em] text-off-white/80 uppercase mt-0.5 font-semibold">
              {link.label}
            </span>
          </a>
        ))}
        <a
          href={general.phoneNumberRaw}
          class="ml-4 relative overflow-hidden bg-gradient-to-r from-accent-red via-accent-red-light to-accent-red px-5 py-2 flex flex-col items-center justify-center group hover:-translate-y-[1px] hover:shadow-lg hover:shadow-accent-red/25 active:translate-y-0 transition-all duration-300 rounded-[2px]"
        >
          <!-- Metallic Shine Sweep -->
          <span class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/30 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-[1.2s] ease-out"></span>
          
          <div class="relative z-10 flex items-center gap-1.5 leading-none">
            <svg class="w-3 h-3 text-dark fill-current" viewBox="0 0 24 24">
              <path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 00-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z"/>
            </svg>
            <span class="text-[9px] font-sans font-bold tracking-widest text-dark/90 uppercase">
              {contactLabelJa}
            </span>
          </div>
          <span class="relative z-10 text-xs md:text-sm font-sans font-bold tracking-wide text-dark mt-1 leading-none">
            {general.phoneNumber}
          </span>
        </a>
      </nav>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden relative z-10 w-9 h-9 flex flex-col justify-center items-center gap-1.5 drop-shadow-[0_2px_4px_rgba(0,0,0,0.6)]"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <span class="menu-line w-6 h-0.5 bg-off-white transition-all duration-300 origin-center"></span>
        <span class="menu-line w-4 h-0.5 bg-off-white transition-all duration-300 ml-auto"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Overlay -->
  <div
    id="mobile-menu"
    class="fixed inset-0 bg-dark/98 backdrop-blur-xl flex flex-col items-center justify-center gap-10 opacity-0 pointer-events-none transition-opacity duration-500 lg:hidden"
  >
    {navLinks.map((link) => (
      <a href={link.href} class="mobile-nav-link">
        <span class="text-2xl font-sans font-light tracking-wide text-off-white">{link.labelJa}</span>
        <span class="text-[12px] font-display tracking-[0.2em] text-off-white/80 uppercase">{link.label}</span>
      </a>
    ))}
    <a
      href={general.phoneNumberRaw}
      class="mt-6 relative overflow-hidden bg-gradient-to-r from-accent-red via-accent-red-light to-accent-red px-8 py-3.5 flex flex-col items-center justify-center gap-1 text-dark hover:-translate-y-[1px] hover:shadow-lg hover:shadow-accent-red/25 transition-all duration-300 rounded-[2px] group"
    >
      <!-- Metallic Shine Sweep -->
      <span class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/25 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-[1.2s] ease-out"></span>
      
      <div class="relative z-10 flex items-center gap-1.5 leading-none">
        <svg class="w-3.5 h-3.5 text-dark fill-current" viewBox="0 0 24 24">
          <path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 00-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z"/>
        </svg>
        <span class="text-[10px] font-sans font-bold tracking-widest text-dark/85 uppercase">{contactLabelJa}</span>
      </div>
      <span class="relative z-10 text-base font-sans font-bold tracking-wider text-dark mt-0.5">{general.phoneNumber}</span>
    </a>
  </div>
</header>

<style>
  .nav-link {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--color-off-white);
    opacity: 0.92;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.7);
    transition: all 0.3s ease;
  }

  .nav-link:hover {
    opacity: 1;
    transform: translateY(-1px);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 10%;
    width: 0;
    height: 1.5px;
    background: var(--color-gold);
    transition: width 0.4s ease;
  }

  .nav-link:hover::after {
    width: 80%;
  }

  .mobile-nav-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--color-off-white);
    opacity: 0.9;
    transition: opacity 0.3s ease;
  }

  .mobile-nav-link:hover {
    opacity: 1;
  }

  /* Header scrolled state */
  #site-header.scrolled {
    background: rgba(10, 10, 10, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(245, 245, 240, 0.08);
  }

  #site-header.scrolled .nav-link {
    opacity: 0.95;
    text-shadow: none;
  }

  /* Mobile menu open state */
  #mobile-menu.open {
    opacity: 1;
    pointer-events: auto;
  }

  #mobile-menu-btn.open .menu-line:first-child {
    transform: rotate(45deg) translateY(4px);
  }

  #mobile-menu-btn.open .menu-line:last-child {
    transform: rotate(-45deg) translateY(-3px);
    width: 1.5rem;
  }
</style>

<script>
  // Header scroll behavior
  const header = document.getElementById('site-header');
  let lastScroll = 0;

  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;

    if (currentScroll > 80) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }

    lastScroll = currentScroll;
  });

  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    const isOpen = menuBtn.classList.toggle('open');
    mobileMenu?.classList.toggle('open');
    menuBtn.setAttribute('aria-expanded', String(isOpen));
    document.body.style.overflow = isOpen ? 'hidden' : '';
  });

  // Close mobile menu on link click
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menuBtn?.classList.remove('open');
      mobileMenu?.classList.remove('open');
      menuBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    });
  });
</script>
