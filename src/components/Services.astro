---
import { Image } from 'astro:assets';
import { siteSettings } from '../config/siteSettings';

const { services, general } = siteSettings;
const { content, style } = services;
---

<section id="services" class={`relative ${style.paddingY} overflow-hidden`}>
  <!-- Section Header -->
  <div class="px-6 md:px-12 lg:px-20 mb-16 md:mb-24 lg:mb-32">
    <div class="max-w-7xl mx-auto">
      <div class="service-reveal flex items-center gap-4 mb-12 md:mb-16 lg:mb-20">
        <span class="w-10 md:w-14 h-px bg-gold/50 flex-shrink-0"></span>
        <div class="flex flex-col gap-1.5">
          <span class="font-sans text-[clamp(1.6rem,3.5vw,2.6rem)] font-light tracking-[0.05em] text-off-white leading-tight">
            {content.sectionLabelJa}
          </span>
          <span class="font-display text-[10px] md:text-xs tracking-[0.35em] text-off-white/40 uppercase leading-none">
            {content.sectionLabel}
          </span>
        </div>
      </div>
      <h2 class="service-reveal">
        <span class={`block font-display ${style.headingSize} font-light tracking-[0.02em] text-off-white leading-[1.15]`}>
          {content.headingLine1}
        </span>
        <span class={`block font-display ${style.headingSize} font-light tracking-[0.02em] text-off-white/75 leading-[1.15] mt-1`}>
          {content.headingLine2}
        </span>
      </h2>
      {content.description && (
        <p class="service-reveal font-sans text-sm md:text-base font-light leading-[2.1] md:leading-[2.3] tracking-[0.04em] text-off-white/85 max-w-4xl mt-6 md:mt-8 whitespace-pre-line [word-break:auto-phrase]">
          {content.description}
        </p>
      )}
    </div>
  </div>

  <!-- Services Grid -->
  <div class="px-6 md:px-12 lg:px-20">
    <div class="max-w-7xl mx-auto">
      <div class={`grid ${style.gridCols} gap-[1px] bg-off-white/[0.03]`}>
        {content.items.map((service, index) => (
          <article
            class="service-card group relative overflow-hidden bg-dark cursor-pointer transition-all duration-300 active:scale-[0.98] active:brightness-95"
            data-service-index={index}
          >
            <!-- Image Background -->
            <div class="relative aspect-square overflow-hidden">
              <Image
                src={service.image}
                alt={service.titleJp}
                class="w-full h-full object-cover object-center transition-transform duration-[1.2s] ease-out group-hover:scale-105 group-[.touched]:scale-105"
                widths={[400, 640, 800]}
                sizes="(max-width: 768px) 100vw, 33vw"
                quality={85}
                loading="lazy"
              />
              <!-- Overlay Gradient -->
              <div class="absolute inset-0 bg-gradient-to-t from-dark/95 via-dark/65 to-transparent opacity-80 group-hover:opacity-95 group-[.touched]:opacity-95 transition-opacity duration-700"></div>

              <!-- Shine Effect -->
              <div class="absolute inset-0 opacity-0 group-hover:opacity-100 group-[.touched]:opacity-100 transition-opacity duration-700">
                <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/[0.04] to-transparent -translate-x-full group-hover:translate-x-full group-[.touched]:translate-x-full transition-transform duration-[1.5s] ease-out"></div>
              </div>
            </div>

            <!-- Content Overlay -->
            <div class="absolute inset-0 flex flex-col justify-end p-4 sm:p-6 md:p-8 lg:p-10">
              <!-- Number -->
              <span class="font-display text-xs md:text-sm tracking-[0.3em] text-gold mb-1.5 block transition-colors duration-500 group-hover:text-gold-light group-[.touched]:text-gold-light">
                {service.number}
              </span>

              <!-- Title English -->
              <h3 class={`font-display ${style.cardTitleSize} font-medium tracking-[0.08em] text-off-white mb-0.5 transition-all duration-500 group-hover:text-gold-light group-hover:-translate-y-1 group-[.touched]:text-gold-light group-[.touched]:-translate-y-1`}>
                {service.title}
              </h3>

              <!-- Title Japanese -->
              <span class="font-sans text-xs md:text-[13px] font-medium tracking-[0.12em] text-warm-gray mb-0 transition-colors duration-500 group-hover:text-off-white group-[.touched]:text-off-white">
                {service.titleJp}
              </span>

              <!-- Divider Line (Responsive: always visible on mobile, grows on hover/touch) -->
              <span class="w-8 h-[2px] bg-gold my-2.5 block transition-all duration-500 origin-left group-hover:w-16 group-[.touched]:w-16"></span>

              <!-- Description Block (always visible on mobile, hover/touch-revealed on desktop) -->
              <div class="service-desc-container overflow-hidden max-w-xs">
                <p class="font-sans text-[11px] sm:text-xs md:text-sm font-light leading-relaxed text-off-white/70 transition-colors duration-500 group-hover:text-off-white/95 group-[.touched]:text-off-white/95 whitespace-pre-line">
                  {service.description}
                </p>
              </div>
            </div>

            <!-- Bottom Border Accent -->
            <div class="absolute bottom-0 left-0 w-0 h-px bg-gold group-hover:w-full group-[.touched]:w-full transition-all duration-700 ease-out"></div>
          </article>
        ))}
      </div>
    </div>
  </div>

  <!-- Contact / Inquiry Prompt at the end of Services -->
  {content.contactPrompt && (
    <div class="px-6 md:px-12 lg:px-20 mt-16 md:mt-24 lg:mt-28">
      <div class="max-w-2xl mx-auto service-reveal text-center flex flex-col items-center">
        <!-- Note text -->
        <p class="font-sans text-xs md:text-sm font-light text-off-white/65 leading-[2] md:leading-[2.2] tracking-wider whitespace-pre-line mb-8 md:mb-10">
          {content.contactPrompt.description}
        </p>

        <!-- Compact Pill Button -->
        <a
          href={general.phoneNumberRaw}
          class="inline-flex items-center gap-3 px-7 py-3 rounded-full border border-gold/35 bg-warm-black/60 hover:bg-gold/10 hover:border-gold text-off-white/90 hover:text-off-white transition-all duration-300 group shadow-sm hover:shadow-gold/10"
        >
          <!-- Phone Icon -->
          <svg class="w-3.5 h-3.5 text-gold flex-shrink-0 group-hover:scale-110 transition-transform duration-300" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 00-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z"/>
          </svg>
          
          <span class="font-sans text-xs md:text-[13px] font-medium tracking-wider">
            {content.contactPrompt.buttonLabel}
          </span>
          <span class="font-sans text-xs md:text-sm font-bold tracking-wider text-gold group-hover:text-gold-light transition-colors">
            {general.phoneNumber}
          </span>
        </a>

        <!-- Small Hours Note -->
        <span class="mt-4 md:mt-5 font-sans text-[11px] md:text-xs text-off-white/40 tracking-wider">
          {content.contactPrompt.subLabel}（受付時間 {general.hours} / {general.holiday}）
        </span>
      </div>
    </div>
  )}

  <!-- Decorative Line -->
  <div class="absolute top-0 left-6 md:left-12 lg:left-20 w-px h-full bg-gold/[0.04]"></div>
</section>

<style>
  /* Mobile layout: always visible, clean text block */
  .service-desc-container {
    max-height: 120px;
    opacity: 1;
    margin-top: 0.5rem;
    transition: all 0.5s ease-out;
  }

  /* Desktop layout: hidden initially, slides open on hover/touch */
  @media (min-width: 768px) {
    .service-desc-container {
      max-height: 0;
      opacity: 0;
      margin-top: 0;
    }

    .service-card:hover .service-desc-container,
    .service-card.touched .service-desc-container {
      max-height: 120px;
      opacity: 1;
      margin-top: 0.75rem;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Section header reveal
  gsap.utils.toArray<HTMLElement>('.service-reveal').forEach((el) => {
    gsap.fromTo(
      el,
      { opacity: 0, y: 40 },
      {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: el,
          start: 'top 85%',
          toggleActions: 'play none none none',
        },
      }
    );
  });

  // Service cards staggered reveal
  const cards = gsap.utils.toArray<HTMLElement>('.service-card');
  cards.forEach((card, i) => {
    gsap.fromTo(
      card,
      {
        opacity: 0,
        y: 60,
      },
      {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: 'power3.out',
        delay: i * 0.15,
        scrollTrigger: {
          trigger: card,
          start: 'top 88%',
          toggleActions: 'play none none none',
        },
      }
    );
  });

  // Touch interactions for mobile devices
  cards.forEach((card) => {
    card.addEventListener('touchstart', () => {
      card.classList.add('touched');
    }, { passive: true });
    card.addEventListener('touchend', () => {
      setTimeout(() => {
        card.classList.remove('touched');
      }, 250);
    }, { passive: true });
    card.addEventListener('touchcancel', () => {
      card.classList.remove('touched');
    }, { passive: true });
  });
</script>
