---
import { Image } from 'astro:assets';
import { siteSettings } from '../config/siteSettings';

const { services, general } = siteSettings;
const { content, style } = services;
---

<section id="services" class={`relative ${style.paddingY} overflow-hidden bg-slate-50`}>
  <!-- Section Header -->
  <div class="px-6 md:px-12 lg:px-20 mb-10 md:mb-14 lg:mb-16">
    <div class="max-w-7xl mx-auto">
      <div class="service-reveal flex items-center gap-5 mb-6 md:mb-8">
        <span class="w-12 md:w-16 h-px bg-gold/60 flex-shrink-0"></span>
        <div class="flex flex-col gap-1.5">
          <h2 class="font-sans text-[clamp(1.8rem,4vw,3rem)] font-light tracking-[0.05em] text-slate-900 leading-tight">
            {content.sectionLabelJa}
          </h2>
          <span class="font-display text-sm sm:text-base md:text-[17px] tracking-[0.3em] text-gold uppercase leading-none font-bold">
            {content.sectionLabel}
          </span>
        </div>
      </div>
      {content.description && (
        <p class="service-reveal font-sans text-base md:text-lg lg:text-[1.15rem] font-normal leading-[2.2] tracking-[0.04em] text-slate-700 max-w-4xl whitespace-pre-line [word-break:auto-phrase]">
          {content.description}
        </p>
      )}
    </div>
  </div>

  <!-- Services Grid -->
  <div class="px-6 md:px-12 lg:px-20">
    <div class="max-w-7xl mx-auto">
      <div class={`grid ${style.gridCols} gap-6 md:gap-8`}>
        {content.items.map((service, index) => (
          <article
            class="service-card group relative overflow-hidden bg-white rounded-sm border border-slate-200/80 shadow-md hover:shadow-xl hover:border-gold/50 cursor-pointer transition-all duration-500 active:scale-[0.98]"
            data-service-index={index}
          >
            <!-- Image Background -->
            <div class="relative aspect-square overflow-hidden">
              <Image
                src={service.image}
                alt={service.titleJp}
                class="w-full h-full object-cover object-center transition-transform duration-[1.2s] ease-out group-hover:scale-105 group-[.touched]:scale-105"
                widths={[400, 640, 800]}
                sizes="(max-width: 768px) 100vw, 33vw"
                quality={85}
                loading="lazy"
              />
            </div>

            <!-- Content Overlay -->
            <div class="absolute inset-0 flex flex-col justify-end p-4 sm:p-6 md:p-8 lg:p-10 bg-gradient-to-t from-black/80 via-black/40 to-transparent">
              <!-- Number -->
              <span class="font-display text-sm md:text-base tracking-[0.3em] text-gold mb-1.5 block transition-colors duration-500 group-hover:text-gold-light group-[.touched]:text-gold-light font-bold drop-shadow-[0_1px_3px_rgba(0,0,0,0.9)]">
                {service.number}
              </span>

              <!-- Title Japanese -->
              <h3 class={`font-sans ${style.cardTitleSize} font-medium tracking-[0.05em] text-white mb-1 transition-all duration-500 group-hover:text-gold-light group-hover:-translate-y-0.5 group-[.touched]:text-gold-light group-[.touched]:-translate-y-0.5 drop-shadow-[0_2px_6px_rgba(0,0,0,0.9)]`}>
                {service.titleJp}
              </h3>

              <!-- Title English -->
              <span class="font-display text-xs md:text-sm font-medium tracking-[0.18em] text-slate-300 uppercase block mb-0 transition-colors duration-500 group-hover:text-white group-[.touched]:text-white drop-shadow-[0_1px_3px_rgba(0,0,0,0.9)]">
                {service.title}
              </span>

              <!-- Divider Line (Responsive: always visible on mobile, grows on hover/touch) -->
              <span class="w-8 h-[2px] bg-gold my-3 block transition-all duration-500 origin-left group-hover:w-16 group-[.touched]:w-16 drop-shadow-[0_1px_3px_rgba(0,0,0,0.8)]"></span>

              <!-- Description Block (always visible on mobile, hover/touch-revealed on desktop) -->
              <div class="service-desc-container overflow-hidden max-w-sm">
                <p class="font-sans text-xs sm:text-[13px] md:text-sm font-normal leading-relaxed text-slate-200 transition-colors duration-500 group-hover:text-white group-[.touched]:text-white whitespace-pre-line drop-shadow-[0_1px_3px_rgba(0,0,0,0.9)]">
                  {service.description}
                </p>
                {service.hasModal && (
                  <div class="mt-2.5 pt-1">
                    <button
                      type="button"
                      id={`open-modal-${service.id}`}
                      class="open-service-modal group/btn inline-flex items-center gap-1 text-xs sm:text-[13px] font-sans font-medium tracking-wider text-gold-light hover:text-white transition-all duration-300 cursor-pointer drop-shadow-[0_1px_2px_rgba(0,0,0,0.8)]"
                      data-modal-target={service.id}
                      aria-haspopup="dialog"
                      aria-controls={`modal-${service.id}`}
                    >
                      <span class="border-b border-gold-light/60 group-hover/btn:border-white pb-0.5 transition-colors duration-300">
                        {service.modalButtonLabel ? service.modalButtonLabel.replace(/＞$/, '') : '詳しく見る'}
                      </span>
                      <span class="inline-block transition-transform duration-300 group-hover/btn:translate-x-1 text-gold-light group-hover/btn:text-white font-normal text-xs">
                        ＞
                      </span>
                    </button>
                  </div>
                )}
                {service.externalLink && (
                  <div class="mt-2.5 pt-1">
                    <a
                      href={service.externalLink}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="service-external-link group/btn inline-flex items-center gap-1 text-xs sm:text-[13px] font-sans font-medium tracking-wider text-gold-light hover:text-white transition-all duration-300 cursor-pointer drop-shadow-[0_1px_2px_rgba(0,0,0,0.8)]"
                    >
                      <span class="border-b border-gold-light/60 group-hover/btn:border-white pb-0.5 transition-colors duration-300">
                        {service.externalLinkLabel ? service.externalLinkLabel.replace(/＞$/, '') : 'サンプルを見る'}
                      </span>
                      <span class="inline-block transition-transform duration-300 group-hover/btn:translate-x-1 text-gold-light group-hover/btn:text-white font-normal text-xs">
                        ＞
                      </span>
                    </a>
                  </div>
                )}
              </div>
            </div>

            <!-- Bottom Border Accent -->
            <div class="absolute bottom-0 left-0 w-0 h-px bg-gold group-hover:w-full group-[.touched]:w-full transition-all duration-700 ease-out"></div>
          </article>
        ))}
      </div>
    </div>
  </div>

  <!-- Body Coating Detail Modal -->
  {content.bodyCoatingModal && (
    <div
      id="modal-body-coating"
      class="service-modal-dialog fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 opacity-0 pointer-events-none transition-opacity duration-300"
      role="dialog"
      aria-modal="true"
      aria-labelledby="body-coating-modal-title"
    >
      <!-- Backdrop Overlay -->
      <div
        class="service-modal-backdrop absolute inset-0 bg-slate-950/75 backdrop-blur-sm transition-opacity duration-300 cursor-pointer"
        data-modal-id="body-coating"
      ></div>

      <!-- Modal Dialog Card -->
      <div
        class="service-modal-panel relative w-full max-w-3xl max-h-[90vh] overflow-y-auto bg-white rounded-sm border border-gold/40 shadow-2xl shadow-slate-950/40 p-6 sm:p-8 md:p-10 transform scale-95 transition-transform duration-300"
      >
        <!-- Close Button -->
        <button
          type="button"
          class="close-service-modal absolute top-5 right-5 w-9 h-9 rounded-full bg-slate-100 hover:bg-gold/15 text-slate-500 hover:text-slate-900 border border-slate-200/80 hover:border-gold/50 flex items-center justify-center transition-all duration-300 cursor-pointer"
          data-modal-id="body-coating"
          aria-label="閉じる"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>

        <!-- Header -->
        <div class="mb-6 pr-8 pb-5 border-b border-slate-100">
          <h3 id="body-coating-modal-title" class="font-sans text-xl sm:text-2xl md:text-[1.65rem] font-medium text-slate-900 tracking-[0.03em] leading-[1.4] whitespace-pre-line">
            {content.bodyCoatingModal.title}
          </h3>
          <div class="w-12 h-[2px] bg-gold mt-3.5 mb-3"></div>
          <p class="font-sans text-sm sm:text-[15px] font-normal text-slate-600 leading-[2] tracking-wide">
            {content.bodyCoatingModal.intro}
          </p>
        </div>

        <!-- Section 1: コーティングの種類と特徴 -->
        {content.bodyCoatingModal.typesSection && (
          <div>
            <h4 class="font-sans text-base sm:text-[17px] font-bold text-slate-900 tracking-wide mb-3.5 pl-3 border-l-2 border-gold py-0.5">
              {content.bodyCoatingModal.typesSection.sectionTitle}
            </h4>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4 items-stretch">
              {content.bodyCoatingModal.typesSection.items.map((type) => (
                <div class="p-4 sm:p-5 rounded-sm bg-gradient-to-br from-[#faf7f2] to-[#f4eee4] border border-gold/40 shadow-sm flex flex-col justify-between h-full">
                  <div class="flex-1 flex flex-col">
                    {type.badge && (
                      <div class="mb-2.5">
                        <span class="inline-block text-[11px] font-sans font-medium px-2.5 py-0.5 rounded-full bg-gold/15 text-gold-dark border border-gold/30">
                          {type.badge}
                        </span>
                      </div>
                    )}
                    <h5 class="font-sans text-sm sm:text-[15px] lg:text-base font-bold text-slate-900 tracking-tight mb-2 whitespace-nowrap">
                      {type.name}
                    </h5>
                    <p class="text-xs sm:text-[13px] text-slate-700 leading-[1.85] font-normal mb-3.5 flex-1">
                      {type.description}
                    </p>
                  </div>
                  <div class="pt-3 border-t border-gold/20 mt-auto">
                    <div class="bg-white/75 p-2.5 rounded-sm border border-gold/15 min-h-[72px] sm:min-h-[76px] flex items-center">
                      <p class="text-[11px] sm:text-xs text-slate-600 font-normal leading-[1.65]">
                        <strong class="text-gold-dark font-medium">おすすめ：</strong>{type.recommendation}
                      </p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- 2つの小見出し間の区切り線 -->
        <div class="w-full h-px bg-slate-200 my-7 sm:my-8" aria-hidden="true"></div>

        <!-- Section 2: 妥協なき施工へのこだわり -->
        {content.bodyCoatingModal.qualitySection && (
          <div class="mb-2">
            <h4 class="font-sans text-base sm:text-[17px] font-bold text-slate-900 tracking-wide mb-2 pl-3 border-l-2 border-gold py-0.5">
              {content.bodyCoatingModal.qualitySection.sectionTitle}
            </h4>

            {content.bodyCoatingModal.qualitySection.intro && (
              <p class="font-sans text-xs sm:text-[13.5px] text-slate-600 leading-[2] tracking-wide mb-4">
                {content.bodyCoatingModal.qualitySection.intro}
              </p>
            )}

            <div class="divide-y divide-slate-100">
              {content.bodyCoatingModal.qualitySection.points.map((point) => (
                <div class="py-4 first:pt-2 last:pb-0 flex gap-4 sm:gap-5 items-start">
                  <span class="font-display text-2xl sm:text-3xl text-gold-dark font-light leading-none shrink-0 mt-0.5 tabular-nums">
                    {point.number}
                  </span>
                  <div>
                    <h5 class="font-sans text-sm sm:text-base font-bold text-slate-900 mb-1 tracking-wide leading-snug">
                      {point.title}
                    </h5>
                    <p class="font-sans text-xs sm:text-sm font-normal text-slate-600 leading-[2] tracking-wide">
                      {point.description}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Footer Note -->
        {content.bodyCoatingModal.footerNote && (
          <div class="pt-4 border-t border-slate-100 mt-6">
            <div class="bg-[#faf8f5] rounded-sm py-3 px-4 border border-gold/20 text-center">
              <p class="font-sans text-xs sm:text-[13px] text-slate-600 font-normal leading-relaxed tracking-wide">
                {content.bodyCoatingModal.footerNote}
              </p>
            </div>
          </div>
        )}
      </div>
    </div>
  )}

  <!-- Contact / Inquiry Prompt at the end of Services -->
  {content.contactPrompt && (
    <div class="px-6 md:px-12 lg:px-20 mt-10 md:mt-14 lg:mt-16">
      <div class="max-w-3xl mx-auto service-reveal text-center flex flex-col items-center">
        <!-- Note text -->
        <p class="font-sans text-sm md:text-base font-normal text-slate-700 leading-[2.2] md:leading-[2.4] tracking-wider whitespace-pre-line mb-6 md:mb-8">
          {content.contactPrompt.description}
        </p>

        <!-- Pill Button (Original design with larger size & navy background) -->
        <a
          href={general.phoneNumberRaw}
          class="inline-flex items-center gap-4 px-9 sm:px-12 py-4 sm:py-5 rounded-full border border-gold/40 bg-[#091426] hover:border-gold hover:bg-[#0d1f38] text-white transition-all duration-300 group shadow-lg shadow-slate-900/10 hover:shadow-gold/10 hover:scale-[1.02] active:scale-[0.98]"
        >
          <!-- Phone Icon -->
          <svg class="w-5 h-5 text-gold flex-shrink-0 group-hover:scale-110 transition-transform duration-300" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 00-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z"/>
          </svg>
          
          <span class="font-sans text-sm sm:text-base font-medium tracking-wider text-white">
            {content.contactPrompt.buttonLabel}
          </span>
          <span class="font-sans text-base sm:text-lg md:text-xl font-bold tracking-wider text-gold group-hover:text-gold-light transition-colors">
            {general.phoneNumber}
          </span>
        </a>

        <!-- Hours Note (Slightly darker shade) -->
        <p class="mt-4 md:mt-5 font-sans text-sm sm:text-base md:text-[17px] text-slate-500 tracking-wider text-center">
          {content.contactPrompt.subLabel}（受付時間 {general.hours} / {general.holiday}）
        </p>
      </div>
    </div>
  )}

</section>

<style>
  /* Mobile layout: always visible, clean text block */
  .service-desc-container {
    max-height: 180px;
    opacity: 1;
    margin-top: 0.5rem;
    transition: all 0.5s ease-out;
  }

  /* Desktop layout: hidden initially, slides open on hover/touch */
  @media (min-width: 768px) {
    .service-desc-container {
      max-height: 0;
      opacity: 0;
      margin-top: 0;
    }

    .service-card:hover .service-desc-container,
    .service-card.touched .service-desc-container {
      max-height: 180px;
      opacity: 1;
      margin-top: 0.75rem;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Section header reveal
  gsap.utils.toArray<HTMLElement>('.service-reveal').forEach((el) => {
    gsap.fromTo(
      el,
      { opacity: 0, y: 40 },
      {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: el,
          start: 'top 85%',
          toggleActions: 'play none none none',
        },
      }
    );
  });

  // Service cards staggered reveal
  const cards = gsap.utils.toArray<HTMLElement>('.service-card');
  cards.forEach((card, i) => {
    gsap.fromTo(
      card,
      {
        opacity: 0,
        y: 60,
      },
      {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: 'power3.out',
        delay: i * 0.15,
        scrollTrigger: {
          trigger: card,
          start: 'top 88%',
          toggleActions: 'play none none none',
        },
      }
    );
  });

  // Touch interactions for mobile devices
  cards.forEach((card) => {
    card.addEventListener('touchstart', () => {
      card.classList.add('touched');
    }, { passive: true });
    card.addEventListener('touchend', () => {
      setTimeout(() => {
        card.classList.remove('touched');
      }, 250);
    }, { passive: true });
    card.addEventListener('touchcancel', () => {
      card.classList.remove('touched');
    }, { passive: true });
  });

  // Service Modal Interactions
  const openModalBtns = document.querySelectorAll<HTMLElement>('.open-service-modal');
  const closeModalBtns = document.querySelectorAll<HTMLElement>('.close-service-modal');
  const modalBackdrops = document.querySelectorAll<HTMLElement>('.service-modal-backdrop');

  function openServiceModal(modalId: string) {
    const modal = document.getElementById(`modal-${modalId}`);
    const panel = modal?.querySelector<HTMLElement>('.service-modal-panel');
    if (!modal || !panel) return;
    modal.classList.remove('opacity-0', 'pointer-events-none');
    modal.classList.add('opacity-100');
    panel.classList.remove('scale-95');
    panel.classList.add('scale-100');
    document.body.style.overflow = 'hidden';
  }

  function closeServiceModal(modalId: string) {
    const modal = document.getElementById(`modal-${modalId}`);
    const panel = modal?.querySelector<HTMLElement>('.service-modal-panel');
    if (!modal || !panel) return;
    modal.classList.add('opacity-0', 'pointer-events-none');
    modal.classList.remove('opacity-100');
    panel.classList.add('scale-95');
    panel.classList.remove('scale-100');
    document.body.style.overflow = '';
  }

  openModalBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const targetId = btn.getAttribute('data-modal-target');
      if (targetId) openServiceModal(targetId);
    });
  });

  // カード全体のクリックでもモーダルまたは外部リンクがある場合は開く（ユーザビリティ向上）
  cards.forEach((card) => {
    const modalBtn = card.querySelector<HTMLElement>('.open-service-modal');
    const extLink = card.querySelector<HTMLAnchorElement>('.service-external-link');
    if (modalBtn) {
      card.addEventListener('click', (e) => {
        // もしクリックされた要素が既にボタン自身であればイベントの重複を防ぐ
        if ((e.target as HTMLElement).closest('.open-service-modal')) return;
        const targetId = modalBtn.getAttribute('data-modal-target');
        if (targetId) openServiceModal(targetId);
      });
    } else if (extLink) {
      card.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('.service-external-link')) return;
        window.open(extLink.href, '_blank', 'noopener,noreferrer');
      });
    }
  });

  closeModalBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const modalId = btn.getAttribute('data-modal-id');
      if (modalId) closeServiceModal(modalId);
    });
  });

  modalBackdrops.forEach((backdrop) => {
    backdrop.addEventListener('click', () => {
      const modalId = backdrop.getAttribute('data-modal-id');
      if (modalId) closeServiceModal(modalId);
    });
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const openModals = document.querySelectorAll<HTMLElement>('.service-modal-dialog:not(.pointer-events-none)');
      openModals.forEach((modal) => {
        const modalId = modal.id.replace('modal-', '');
        closeServiceModal(modalId);
      });
    }
  });
</script>
