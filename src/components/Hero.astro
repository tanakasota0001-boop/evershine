---
import { Image } from "astro:assets";
import { siteSettings } from "../config/siteSettings";

const { hero } = siteSettings;
const { content, style } = hero;
---

<section
  id="hero"
  class="relative w-full h-screen min-h-[550px] md:min-h-[700px] overflow-hidden"
>
  <!-- Background Image with Parallax -->
  <div id="hero-parallax" class="absolute inset-0 scale-110">
    <Image
      src={content.image}
      alt={content.imageAlt}
      class="w-full h-full object-cover"
      widths={[640, 1024, 1536, 2048]}
      sizes="100vw"
      quality={85}
      loading="eager"
      fetchpriority="high"
    />
    <!-- Dark overlay gradient -->
    <div
      class={`absolute inset-0 bg-gradient-to-r ${style.gradientOverlayLeft}`}
    >
    </div>
    <div
      class={`absolute inset-0 bg-gradient-to-t ${style.gradientOverlayBottom}`}
    >
    </div>
    <!-- Scroll Darken Overlay (徐々に黒くフェード) -->
    <div
      id="hero-darken-overlay"
      class="absolute inset-0 bg-black opacity-0 pointer-events-none"
    >
    </div>
  </div>

  <!-- Content -->
  <div
    class={`relative z-10 h-full flex flex-col justify-center md:justify-end ${style.paddingBottom} px-6 md:px-12 lg:px-20 ${style.textAlign === "text-center" ? "items-center" : style.textAlign === "text-right" ? "items-end" : ""}`}
  >
    <!-- Main Content: Asymmetric Left-Aligned -->
    <div
      class={`relative ${style.maxWidth} ${style.textAlign} before:absolute before:-inset-6 sm:before:-inset-10 before:bg-gradient-to-r before:from-black/40 before:via-black/20 before:to-transparent before:blur-2xl before:-z-10 before:rounded-3xl before:pointer-events-none`}
    >
      <div>
        <!-- Pre-label / Badge (①) -->
        {content.preLabel && (
          <div id="hero-badge" class={`flex items-center -mt-12 md:-mt-6 lg:-mt-8 mb-10 md:mb-12 lg:mb-14 opacity-0 ${style.textAlign === "text-center" ? "justify-center" : style.textAlign === "text-right" ? "justify-end" : "justify-start"}`}>
            <span class={`inline-block font-display ${style.preLabelSize || "text-base sm:text-lg md:text-xl lg:text-2xl tracking-[0.25em]"} ${style.preLabelColor || "text-gold-light"} uppercase font-bold [text-shadow:_0_1px_3px_rgba(0,0,0,0.45)] md:[text-shadow:none] drop-shadow-[0_2px_4px_rgba(0,0,0,0.95)] drop-shadow-[0_4px_16px_rgba(0,0,0,0.85)]`}>
              {content.preLabel}
            </span>
          </div>
        )}

        <!-- Main Heading -->
        <h1 class="mb-6 md:mb-8">
          <span class="sr-only">長野県塩尻市・松本市のカーコーティング・ガラスコーティング専門店 EVERSHINE（エバーシャイン）- </span>
          <span
            id="hero-line-1"
            class={`block font-display ${style.titleLine1Size} font-normal md:font-medium leading-[1.15] tracking-[0.03em] ${style.titleColor} drop-shadow-[0_2px_6px_rgba(0,0,0,0.95)] drop-shadow-[0_4px_20px_rgba(0,0,0,0.9)] opacity-0 whitespace-nowrap`}
          >
            {content.line1}
          </span>
          <span
            id="hero-line-2"
            class={`block font-display ${style.titleLine2Size} font-normal md:font-medium leading-[1.1] tracking-[0.03em] ${style.titleColor} drop-shadow-[0_2px_6px_rgba(0,0,0,0.95)] drop-shadow-[0_4px_20px_rgba(0,0,0,0.9)] mt-1.5 md:mt-3 opacity-0 whitespace-nowrap`}
            data-highlight={content.highlightText}
            data-highlight-class={style.highlightColor}
          >
            {content.line2}
          </span>
        </h1>

        <!-- Sub Heading -->
        <p
          id="hero-sub"
          class={`font-sans ${style.subtitleSize} font-medium tracking-[0.1em] ${style.subtitleColor} [text-shadow:_0_1px_3px_rgba(0,0,0,0.45)] md:[text-shadow:none] drop-shadow-[0_2px_6px_rgba(0,0,0,0.95)] drop-shadow-[0_4px_16px_rgba(0,0,0,0.9)] max-w-2xl opacity-0 ${style.textAlign === "text-center" ? "mx-auto" : style.textAlign === "text-right" ? "ml-auto" : ""}`}
        >
          {content.subtitle}
        </p>
      </div>
    </div>
  </div>

  <!-- Hero Stats Floating Badge (③) -->
  {content.stats && content.stats.length > 0 && (
    <div
      id="hero-stats-badge"
      class="hidden md:flex absolute bottom-14 md:bottom-16 lg:bottom-20 right-8 lg:right-16 z-20 items-center gap-8 py-4.5 px-8 lg:py-5 lg:px-9 rounded-sm bg-[#091426]/80 backdrop-blur-md border border-gold/30 shadow-[0_8px_30px_rgba(9,20,38,0.5)] opacity-0 transition-all duration-300 hover:border-gold/50"
    >
      {content.stats.map((stat, idx) => (
        <>
          {idx > 0 && <div class="w-px h-9 bg-gold/25"></div>}
          <div class="flex flex-col">
            <span class="font-display text-xl lg:text-2xl font-normal text-gold tracking-tight leading-none">
              {stat.number}
            </span>
            <span class="font-sans text-xs md:text-[13px] font-normal text-white/90 tracking-widest leading-tight mt-1.5">
              {stat.label}
            </span>
          </div>
        </>
      ))}
    </div>
  )}

  <!-- Scroll Indicator -->
  <div
    id="hero-scroll-indicator"
    class="absolute bottom-20 md:bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2.5 opacity-0 pointer-events-none z-20"
  >
    <span
      class="font-display text-xs sm:text-sm md:text-sm tracking-[0.35em] text-gold-light uppercase font-bold drop-shadow-[0_2px_6px_rgba(0,0,0,0.95)]"
      >{content.scrollText}</span
    >
    <div class="w-[2px] h-12 md:h-14 relative overflow-hidden rounded-full bg-white/30 drop-shadow-[0_2px_6px_rgba(0,0,0,0.9)]">
      <div
        class="scroll-line-active absolute w-full bg-gradient-to-b from-gold-light via-white to-gold-light rounded-full shadow-[0_0_8px_rgba(255,255,255,0.9)]"
        style="height: 45%; animation: scrollDown 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;"
      >
      </div>
    </div>
  </div>
</section>

<style>
  .writing-vertical {
    writing-mode: vertical-rl;
    text-orientation: mixed;
  }

  @keyframes scrollDown {
    0% {
      top: -45%;
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    75% {
      opacity: 1;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Wait for page load
  window.addEventListener("load", () => {
    const tl = gsap.timeline({ defaults: { ease: "power3.out" } });

    // Pre-badge (①)
    const badge = document.getElementById("hero-badge");
    if (badge) {
      tl.to(
        "#hero-badge",
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
          delay: 0.2,
        },
        0,
      );
      tl.from(
        "#hero-badge",
        {
          y: 20,
          duration: 0.8,
          delay: 0.2,
        },
        0,
      );
    }

    // Main heading line 1 - character by character
    const line1 = document.getElementById("hero-line-1");
    if (line1) {
      const text1 = line1.textContent || "";
      line1.innerHTML = "";
      line1.style.opacity = "1";
      text1
        .trim()
        .split("")
        .forEach((char) => {
          const span = document.createElement("span");
          span.textContent = char;
          span.style.display = "inline-block";
          span.style.opacity = "0";
          span.style.transform = "translateY(40px)";
          if (char === " ") span.style.width = "0.3em";
          line1.appendChild(span);
        });

      tl.to(
        line1.children,
        {
          opacity: 1,
          y: 0,
          duration: 0.5,
          stagger: 0.04,
          ease: "power2.out",
        },
        0.6,
      );
    }

    // Main heading line 2 - character by character
    const line2 = document.getElementById("hero-line-2");
    if (line2) {
      const text2 = line2.textContent || "";
      const highlight = line2.getAttribute("data-highlight") || "";
      const highlightClass =
        line2.getAttribute("data-highlight-class") || "text-gold-light";
      line2.innerHTML = "";
      line2.style.opacity = "1";
      text2
        .trim()
        .split("")
        .forEach((char) => {
          const span = document.createElement("span");
          span.textContent = char;
          span.style.display = "inline-block";
          span.style.opacity = "0";
          span.style.transform = "translateY(40px)";
          if (char === " ") span.style.width = "0.3em";
          if (highlight && highlight.includes(char)) {
            highlightClass.split(" ").forEach((cls) => {
              if (cls) span.classList.add(cls);
            });
          }
          line2.appendChild(span);
        });

      tl.to(
        line2.children,
        {
          opacity: 1,
          y: 0,
          duration: 0.5,
          stagger: 0.04,
          ease: "power2.out",
        },
        1.0,
      );
    }


    // Sub heading
    tl.to(
      "#hero-sub",
      {
        opacity: 1,
        y: 0,
        duration: 0.8,
      },
      1.4,
    );

    tl.from(
      "#hero-sub",
      {
        y: 20,
        duration: 0.8,
      },
      1.4,
    );

    // CTA
    tl.to(
      "#hero-cta",
      {
        opacity: 1,
        y: 0,
        duration: 0.8,
      },
      1.7,
    );

    tl.from(
      "#hero-cta",
      {
        y: 20,
        duration: 0.8,
      },
      1.7,
    );

    // Stats floating badge (③)
    const statsBadge = document.getElementById("hero-stats-badge");
    if (statsBadge) {
      tl.to(
        "#hero-stats-badge",
        {
          opacity: 1,
          y: 0,
          duration: 1,
        },
        1.6,
      );
      tl.from(
        "#hero-stats-badge",
        {
          y: 30,
          duration: 1,
        },
        1.6,
      );
    }

    // Scroll indicator
    tl.to(
      "#hero-scroll-indicator",
      {
        opacity: 1,
        duration: 1,
      },
      2.0,
    );

    // Parallax on scroll
    gsap.to("#hero-parallax", {
      yPercent: 20,
      ease: "none",
      scrollTrigger: {
        trigger: "#hero",
        start: "top top",
        end: "bottom top",
        scrub: 0.5,
      },
    });

    // Darken background overlay on scroll (早めのタイミングで適度な上品な暗さにトーンダウン)
    gsap.to("#hero-darken-overlay", {
      opacity: 0.65,
      ease: "power1.inOut",
      scrollTrigger: {
        trigger: "#hero",
        start: "top top",
        end: "55% top",
        scrub: 0.3,
      },
    });

    // Fade out hero content on scroll
    gsap.to("#hero .relative.z-10", {
      opacity: 0,
      y: -50,
      ease: "none",
      scrollTrigger: {
        trigger: "#hero",
        start: "25% top",
        end: "60% top",
        scrub: 0.3,
      },
    });
  });
</script>
