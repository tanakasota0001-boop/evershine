---
import { siteSettings } from '../config/siteSettings';

const { flow } = siteSettings;
const { content, style } = flow;
---

<section id="flow" class={`relative ${style.paddingY} overflow-hidden bg-slate-50`}>
  <!-- Background Ornamental Top/Bottom Lines -->
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-gold/20 to-transparent"></div>
  <div class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-gold/20 to-transparent"></div>

  <!-- Ambient Subtle Glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[1000px] h-[350px] bg-gold/[0.02] rounded-full blur-[150px] pointer-events-none"></div>

  <div class="px-6 md:px-10 lg:px-8 xl:px-12 relative z-10">
    <div class={`${style.maxWidth || 'max-w-[92rem]'} mx-auto`}>
      
      <!-- Section Header -->
      <div class="text-center mb-14 md:mb-20 lg:mb-28">
        <div class="flow-reveal flex items-center justify-center gap-5 mb-4">
          <span class="w-12 md:w-16 h-px bg-gold/60 flex-shrink-0"></span>
          <h2 class="flex flex-col items-center gap-1.5">
            <span class="font-sans text-[clamp(1.8rem,4vw,3rem)] font-light tracking-[0.06em] text-slate-900 leading-tight">
              {content.sectionLabelJa}
            </span>
            <span class="font-display text-sm sm:text-base md:text-[17px] tracking-[0.3em] text-gold uppercase leading-none font-bold">
              {content.sectionLabel}
            </span>
          </h2>
          <span class="w-12 md:w-16 h-px bg-gold/60 flex-shrink-0"></span>
        </div>
      </div>

      <!-- Option C: Minimalist Horizontal Orbit Flow -->
      <div class="relative">
        
        <!-- Horizontal Golden Orbit Line (Desktop only) -->
        <div class="hidden lg:block absolute top-[15px] left-[10%] right-[10%] h-px bg-gradient-to-r from-gold/15 via-gold/40 to-gold/15 z-0"></div>

        <!-- 5 Steps Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-0 md:gap-8 lg:gap-5 xl:gap-7 relative z-10">
          {content.steps.map((step, index) => (
            <div class={`flow-step group relative flex flex-col items-center text-center h-full ${index === 4 ? 'md:col-span-2 md:max-w-[calc(50%-1rem)] md:mx-auto lg:col-span-1 lg:max-w-none' : ''}`}>
              
              <!-- Milestone Node Point (Desktop only - sits on the horizontal orbit line) -->
              <div class="hidden lg:flex relative mb-6 z-10">
                <div class="w-8 h-8 rounded-full border border-[#0b1a30]/20 bg-white shadow-sm flex items-center justify-center group-hover:border-gold group-hover:shadow-md group-hover:shadow-gold/20 transition-all duration-300">
                  <div class="w-2 h-2 rounded-full bg-[#0b1a30] group-hover:bg-gold group-hover:scale-150 transition-all duration-300"></div>
                </div>
              </div>

              <!-- Step Card (Simple & matching other sections) -->
              <div class="w-full flex-1 flex flex-col items-center text-center bg-white rounded-sm border border-slate-200/80 shadow-sm group-hover:border-gold/50 group-hover:shadow-md group-hover:-translate-y-1 transition-all duration-300 p-6 sm:p-7 lg:p-5 xl:p-7">
                <!-- Big Display Number -->
                <span class="font-display text-3xl sm:text-4xl lg:text-[42px] xl:text-5xl font-normal text-gold-dark tracking-wider group-hover:text-gold transition-colors duration-300 leading-none mb-3">
                  {step.number}
                </span>

                <!-- Icon -->
                <div class="mb-4 flex justify-center text-[#0b1a30] group-hover:text-gold group-hover:scale-105 transition-all duration-300">
                  <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-full border border-slate-200 bg-slate-50 flex items-center justify-center group-hover:border-gold/40 group-hover:bg-gold/[0.06] transition-all duration-300">
                    <span set:html={step.icon} />
                  </div>
                </div>

                <!-- Titles -->
                <h3 class="font-sans text-base sm:text-lg xl:text-[19px] font-medium tracking-[0.08em] text-slate-900 mb-1.5 group-hover:text-gold-dark transition-colors duration-300">
                  {step.title}
                </h3>

                <!-- Golden Accent Divider -->
                <div class="w-8 h-px bg-gold/40 my-2.5 group-hover:w-14 transition-all duration-300 ease-out"></div>

                <!-- Description -->
                <p class="font-sans text-xs sm:text-sm md:text-[14px] xl:text-[14.5px] font-normal leading-[2] sm:leading-[2.1] tracking-wider text-slate-700 max-w-[260px] mx-auto whitespace-pre-line mt-1">
                  {step.description}
                </p>

              </div>

              <!-- Mobile Step Flow Connector Arrow (Tip only, larger, perfectly centered) -->
              {index < content.steps.length - 1 && (
                <div class="md:hidden flex justify-center py-4 text-gold" aria-hidden="true">
                  <svg class="w-6 h-6 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Header Reveal
  gsap.utils.toArray<HTMLElement>('.flow-reveal').forEach((el) => {
    gsap.fromTo(
      el,
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: el,
          start: 'top 85%',
          toggleActions: 'play none none none',
        },
      }
    );
  });

  // Staggered Steps Reveal
  const steps = gsap.utils.toArray<HTMLElement>('.flow-step');
  steps.forEach((step, i) => {
    gsap.fromTo(
      step,
      {
        opacity: 0,
        y: 35,
      },
      {
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: 'power3.out',
        delay: i * 0.12,
        scrollTrigger: {
          trigger: step,
          start: 'top 88%',
          toggleActions: 'play none none none',
        },
      }
    );
  });
</script>
