---
import { Image } from "astro:assets";
import { siteSettings } from "../config/siteSettings";

const { access, general } = siteSettings;
const { content, style } = access;
---

<section
  id="access"
  class="relative pb-16 md:pb-24 lg:pb-32 overflow-hidden bg-white text-slate-900"
>
  <!-- Background Ornamental Elements -->
  <div
    class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-gold/30 to-transparent z-10"
  >
  </div>

  <!-- Full-width Shop Exterior Image at Top of Section with Subtle Bottom-only Dissolve -->
  <div class="access-reveal w-full relative overflow-hidden aspect-[21/9] sm:aspect-[24/9] md:aspect-[28/9] max-h-[500px] min-h-[240px] mb-8 sm:mb-12 md:mb-16 [mask-image:linear-gradient(to_bottom,black_75%,transparent_100%)] [-webkit-mask-image:linear-gradient(to_bottom,black_75%,transparent_100%)]">
    <Image
      src={content.shopImage}
      alt="EVERSHINE 店舗外観"
      class="w-full h-full object-cover object-[28%_center] md:object-center"
      widths={[640, 1024, 1536, 2048]}
      sizes="100vw"
      quality={90}
      loading="lazy"
    />
    <!-- Subtle bottom gradient dissolve into pure white section background -->
    <div class="absolute inset-x-0 bottom-0 h-20 sm:h-28 md:h-36 bg-gradient-to-t from-white via-white/80 to-transparent pointer-events-none"></div>
  </div>

  <div class="relative z-10 px-6 md:px-12 lg:px-20">
    <div class="max-w-7xl mx-auto">
      <!-- Section Header (Above Store Info and Map) -->
      <div class="text-center mb-10 md:mb-14 lg:mb-16">
        <div class="access-reveal flex items-center justify-center gap-5">
          <span class="w-12 md:w-16 h-px bg-gold/60 flex-shrink-0"></span>
          <h2 class="flex flex-col items-center gap-1.5">
            <span
              class="font-sans text-[clamp(1.8rem,4vw,3rem)] font-light tracking-[0.05em] text-slate-900 leading-tight"
            >
              {content.sectionLabelJa}
            </span>
            <span
              class="font-display text-sm sm:text-base md:text-[17px] tracking-[0.3em] text-gold uppercase leading-none font-bold"
            >
              {content.sectionLabel}
            </span>
          </h2>
          <span class="w-12 md:w-16 h-px bg-gold/60 flex-shrink-0"></span>
        </div>
      </div>

      <!-- Layout Container: Side-by-Side Grid (Store Info & Map) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10 xl:gap-12 items-stretch">
        
        <!-- Left Column: Company Info (Non-card, Editorial List) -->
        <div class="access-reveal flex flex-col justify-between">
          <div>
            <!-- Company Name -->
            <div class="mb-5 md:mb-6 pb-3 border-b border-slate-200">
              <span
                class="font-display text-[clamp(1.55rem,3.2vw,2.4rem)] tracking-[0.02em] sm:tracking-[0.05em] text-slate-900 font-light whitespace-nowrap block"
              >
                {general.companyName}
              </span>
            </div>

            <!-- Info Items -->
            <address class="space-y-4 md:space-y-4.5 not-italic">
              <!-- Address -->
              <div class="flex gap-4 md:gap-6 items-start py-0.5">
                <div class="w-24 sm:w-28 shrink-0 flex flex-col">
                  <span
                    class="font-sans text-base sm:text-lg md:text-xl font-medium tracking-wider text-slate-900 leading-tight"
                  >
                    住所
                  </span>
                  <span
                    class="font-display text-[10px] md:text-[11px] tracking-[0.2em] text-gold-dark uppercase leading-none mt-1.5 font-bold"
                  >
                    Address
                  </span>
                </div>
                <div>
                  <p
                    class="font-sans text-sm sm:text-base md:text-[16px] font-normal leading-[1.7] tracking-[0.04em] text-slate-700"
                  >
                    {general.zipCode}<br />
                    {general.address}
                  </p>
                </div>
              </div>

              <!-- Divider -->
              <div class="w-full h-px bg-slate-200"></div>

              <!-- Access / Directions -->
              <div class="flex gap-4 md:gap-6 items-start py-0.5">
                <div class="w-24 sm:w-28 shrink-0 flex flex-col">
                  <span
                    class="font-sans text-base sm:text-lg md:text-xl font-medium tracking-wider text-slate-900 leading-tight"
                  >
                    アクセス
                  </span>
                  <span
                    class="font-display text-[10px] md:text-[11px] tracking-[0.2em] text-gold-dark uppercase leading-none mt-1.5 font-bold"
                  >
                    Access
                  </span>
                </div>
                <div>
                  <p
                    class="font-sans text-sm sm:text-base md:text-[16px] font-normal leading-[1.7] tracking-[0.03em] text-slate-700"
                  >
                    {general.directions}
                  </p>
                </div>
              </div>

              <!-- Divider -->
              <div class="w-full h-px bg-slate-200"></div>

              <!-- Phone -->
              <div class="flex gap-4 md:gap-6 items-start py-0.5">
                <div class="w-24 sm:w-28 shrink-0 flex flex-col">
                  <span
                    class="font-sans text-base sm:text-lg md:text-xl font-medium tracking-wider text-slate-900 leading-tight"
                  >
                    電話番号
                  </span>
                  <span
                    class="font-display text-[10px] md:text-[11px] tracking-[0.2em] text-gold-dark uppercase leading-none mt-1.5 font-bold"
                  >
                    Tel
                  </span>
                </div>
                <div>
                  <a
                    href={general.phoneNumberRaw}
                    class="font-sans text-sm sm:text-base md:text-lg font-medium tracking-[0.03em] text-slate-900 hover:text-gold-dark transition-colors duration-300"
                  >
                    {general.phoneNumber}
                  </a>
                </div>
              </div>

              <!-- Divider -->
              <div class="w-full h-px bg-slate-200"></div>

              <!-- Hours -->
              <div class="flex gap-4 md:gap-6 items-start py-0.5">
                <div class="w-24 sm:w-28 shrink-0 flex flex-col">
                  <span
                    class="font-sans text-base sm:text-lg md:text-xl font-medium tracking-wider text-slate-900 leading-tight"
                  >
                    営業時間
                  </span>
                  <span
                    class="font-display text-[10px] md:text-[11px] tracking-[0.2em] text-gold-dark uppercase leading-none mt-1.5 font-bold"
                  >
                    Hours
                  </span>
                </div>
                <div>
                  <p
                    class="font-sans text-sm sm:text-base md:text-[16px] font-normal tracking-[0.03em] text-slate-700"
                  >
                    {general.hours}
                  </p>
                  <p
                    class="font-sans text-xs sm:text-sm font-normal tracking-[0.03em] text-slate-500 mt-1"
                  >
                    {general.holiday}
                  </p>
                </div>
              </div>

              <!-- Divider -->
              <div class="w-full h-px bg-slate-200"></div>

              <!-- Parking / Access Note -->
              <div class="flex gap-4 md:gap-6 items-start py-0.5">
                <div class="w-24 sm:w-28 shrink-0 flex flex-col">
                  <span
                    class="font-sans text-base sm:text-lg md:text-xl font-medium tracking-wider text-slate-900 leading-tight"
                  >
                    駐車場
                  </span>
                  <span
                    class="font-display text-[10px] md:text-[11px] tracking-[0.2em] text-gold-dark uppercase leading-none mt-1.5 font-bold"
                  >
                    Parking
                  </span>
                </div>
                <div>
                  <p
                    class="font-sans text-sm sm:text-base md:text-[16px] font-normal tracking-[0.03em] text-slate-700"
                  >
                    専用駐車スペース完備
                  </p>
                  <p
                    class="font-sans text-xs sm:text-sm font-normal tracking-[0.03em] text-slate-500 mt-1"
                  >
                    お車でお越しの際はそのまま店舗前へお進みください。
                  </p>
                </div>
              </div>
            </address>
          </div>
        </div>

        <!-- Right Column: Sleek Google Map -->
        <div class="access-reveal flex flex-col h-full">
          <!-- Google Maps Embed Container -->
          <div class="relative w-full h-[320px] sm:h-[380px] lg:h-full min-h-[300px] lg:min-h-[420px] overflow-hidden rounded-sm bg-slate-100 border border-slate-200 shadow-md flex-1">
            <iframe
              src="https://maps.google.com/maps?q=EVERSHINE%20%E9%95%B7%E9%87%8E%E7%9C%8C%E5%A1%A9%E5%B0%BB%E5%B8%82%E5%BA%83%E4%B8%98%E5%A0%85%E7%9F%B32146-161&output=embed"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen={true}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="absolute inset-0 w-full h-full"
              title={content.mapTitle}></iframe>
          </div>
        </div>

      </div>

      <!-- Google Maps Button (Centered with generous lower spacing) -->
      <div class="access-reveal flex justify-center pt-10 md:pt-14">
        <a
          href={content.googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 px-8 py-3.5 sm:px-10 sm:py-4 rounded-full border border-gold bg-white hover:bg-gold hover:text-white text-slate-800 transition-all duration-300 group shadow-md hover:shadow-lg text-sm sm:text-base font-sans tracking-widest font-medium"
        >
          <!-- Map Pin Icon -->
          <svg class="w-4 h-4 text-gold group-hover:text-white transition-colors duration-300 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span>Googleマップで開く</span>
          <!-- Arrow Icon -->
          <svg
            width="12"
            height="12"
            viewBox="0 0 14 14"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            class="transform transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 text-gold group-hover:text-white"
          >
            <path d="M1 13L13 1M13 1H5M13 1v8"></path>
          </svg>
        </a>
      </div>

    </div>
  </div>

  <div
    class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-gold/30 to-transparent z-10"
  >
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray<HTMLElement>(".access-reveal").forEach((el, i) => {
    gsap.fromTo(
      el,
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: "power3.out",
        delay: i * 0.15,
        scrollTrigger: {
          trigger: el,
          start: "top 85%",
          toggleActions: "play none none none",
        },
      },
    );
  });
</script>
