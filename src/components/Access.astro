---
import { Image } from "astro:assets";
import { siteSettings } from "../config/siteSettings";

const { access, general } = siteSettings;
const { content, style } = access;
---

<section
  id="access"
  class={`relative ${style.paddingY} overflow-hidden bg-warm-black`}
>
  <div
    class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-gold/10 to-transparent"
  >
  </div>

  <div class="px-6 md:px-12 lg:px-20">
    <div class="max-w-7xl mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-16 md:mb-24">
        <div class="access-reveal flex items-center justify-center gap-6">
          <span class="w-10 md:w-14 h-px bg-gold/50 flex-shrink-0"></span>
          <h2 class="flex flex-col items-center gap-1.5">
            <span
              class="font-sans text-[clamp(1.6rem,3.5vw,2.6rem)] font-light tracking-[0.05em] text-off-white leading-tight"
            >
              {content.sectionLabelJa}
            </span>
            <span
              class="font-display text-[10px] md:text-xs tracking-[0.35em] text-off-white/40 uppercase leading-none"
            >
              {content.sectionLabel}
            </span>
          </h2>
          <span class="w-10 md:w-14 h-px bg-gold/50 flex-shrink-0"></span>
        </div>
      </div>

      <!-- Layout Container -->
      <div class="space-y-12 lg:space-y-16">
        
        <!-- Top Row: Company Info & Exterior Photo (Balanced 2 Columns) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
          
          <!-- Left: Company Info (7 Columns) -->
          <div class="access-reveal lg:col-span-7">
            <!-- Company Name -->
            <div class="mb-8 md:mb-10">
              <span
                class="font-display text-2xl md:text-3xl lg:text-4xl tracking-[0.12em] text-off-white font-light"
              >
                {general.companyName}
              </span>
            </div>

            <!-- Info Items -->
            <address class="space-y-5 md:space-y-6 not-italic">
              <!-- Address -->
              <div class="flex gap-4 items-start py-1">
                <div class="w-20 md:w-24 shrink-0 flex flex-col">
                  <span
                    class="font-display text-[10px] tracking-[0.25em] text-gold/75 uppercase leading-none mt-0.5"
                  >
                    Address
                  </span>
                  <span
                    class="font-sans text-[9px] text-off-white/45 tracking-widest mt-1.5 uppercase leading-none"
                  >
                    住所
                  </span>
                </div>
                <div>
                  <p
                    class="font-sans text-sm font-light leading-[1.8] tracking-[0.04em] text-off-white/80"
                  >
                    {general.zipCode}<br />
                    {general.address}
                  </p>
                </div>
              </div>

              <!-- Divider -->
              <div class="w-full h-px bg-gradient-to-r from-gold/10 to-transparent"></div>

              <!-- Phone -->
              <div class="flex gap-4 items-start py-1">
                <div class="w-20 md:w-24 shrink-0 flex flex-col">
                  <span
                    class="font-display text-[10px] tracking-[0.25em] text-gold/75 uppercase leading-none mt-0.5"
                  >
                    Tel
                  </span>
                  <span
                    class="font-sans text-[9px] text-off-white/45 tracking-widest mt-1.5 uppercase leading-none"
                  >
                    電話番号
                  </span>
                </div>
                <div>
                  <a
                    href={general.phoneNumberRaw}
                    class="font-sans text-sm font-light tracking-[0.03em] text-off-white/80 hover:text-gold transition-colors duration-300"
                  >
                    {general.phoneNumber}
                  </a>
                </div>
              </div>

              <!-- Divider -->
              <div class="w-full h-px bg-gradient-to-r from-gold/10 to-transparent"></div>

              <!-- Hours -->
              <div class="flex gap-4 items-start py-1">
                <div class="w-20 md:w-24 shrink-0 flex flex-col">
                  <span
                    class="font-display text-[10px] tracking-[0.25em] text-gold/75 uppercase leading-none mt-0.5"
                  >
                    Hours
                  </span>
                  <span
                    class="font-sans text-[9px] text-off-white/45 tracking-widest mt-1.5 uppercase leading-none"
                  >
                    営業時間
                  </span>
                </div>
                <div>
                  <p
                    class="font-sans text-sm font-light tracking-[0.03em] text-off-white/80"
                  >
                    {general.hours}
                  </p>
                  <p
                    class="font-sans text-xs font-light tracking-[0.03em] text-off-white/55 mt-1"
                  >
                    {general.holiday}
                  </p>
                </div>
              </div>

              <!-- Divider -->
              <div class="w-full h-px bg-gradient-to-r from-gold/10 to-transparent"></div>

              <!-- Parking / Access Note -->
              <div class="flex gap-4 items-start py-1">
                <div class="w-20 md:w-24 shrink-0 flex flex-col">
                  <span
                    class="font-display text-[10px] tracking-[0.25em] text-gold/75 uppercase leading-none mt-0.5"
                  >
                    Parking
                  </span>
                  <span
                    class="font-sans text-[9px] text-off-white/45 tracking-widest mt-1.5 uppercase leading-none"
                  >
                    駐車場
                  </span>
                </div>
                <div>
                  <p
                    class="font-sans text-sm font-light tracking-[0.03em] text-off-white/80"
                  >
                    専用駐車スペース完備
                  </p>
                  <p
                    class="font-sans text-xs font-light tracking-[0.03em] text-off-white/55 mt-1"
                  >
                    お車でお越しの際はそのまま店舗前へお進みください。
                  </p>
                </div>
              </div>
            </address>
          </div>

          <!-- Right: Shop Exterior Photo (5 Columns) -->
          <div class="access-reveal lg:col-span-5 flex justify-center">
            <div class="relative w-full max-w-md aspect-square overflow-hidden rounded-sm bg-dark shadow-xl shadow-black/30">
              <Image
                src={content.shopImage}
                alt="EVERSHINE 店舗外観"
                width={800}
                height={800}
                class="w-full h-full object-cover object-[center_50%]"
                loading="lazy"
              />
            </div>
          </div>
        </div>

        <!-- Bottom Row: Sleek Wide Google Map -->
        <div class="access-reveal space-y-3">
          <div class="relative w-full h-[280px] sm:h-[340px] md:h-[380px] overflow-hidden rounded-sm bg-dark shadow-xl shadow-black/30">
            <iframe
              src="https://maps.google.com/maps?q=EVERSHINE%20%E9%95%B7%E9%87%8E%E7%9C%8C%E5%A1%A9%E5%B0%BB%E5%B8%82%E5%BA%83%E4%B8%98%E5%A0%85%E7%9F%B32146-161&output=embed"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen={true}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="absolute inset-0 w-full h-full grayscale-[25%] contrast-[1.15]"
              title={content.mapTitle}></iframe>
          </div>

          <!-- Google Maps Link Button -->
          <div class="flex justify-end pt-1">
            <a
              href={content.googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-xs font-sans tracking-widest text-gold hover:text-gold-light transition-colors duration-300 group"
            >
              <span>Googleマップで表示</span>
              <svg
                width="12"
                height="12"
                viewBox="0 0 14 14"
                fill="none"
                stroke="currentColor"
                stroke-width="1.2"
                class="transform transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              >
                <path d="M1 13L13 1M13 1H5M13 1v8"></path>
              </svg>
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>

  <div
    class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-gold/10 to-transparent"
  >
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray<HTMLElement>(".access-reveal").forEach((el, i) => {
    gsap.fromTo(
      el,
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: "power3.out",
        delay: i * 0.15,
        scrollTrigger: {
          trigger: el,
          start: "top 85%",
          toggleActions: "play none none none",
        },
      },
    );
  });
</script>
