---
import { Image } from "astro:assets";
import { siteSettings } from "../config/siteSettings";

const { access, general } = siteSettings;
const { content, style } = access;
---

<section
  id="access"
  class={`relative ${style.paddingY} overflow-hidden bg-slate-950 text-white`}
>
  <!-- Background Image with Dark Overlay -->
  <div class="absolute inset-0 z-0 bg-slate-950">
    <!-- Image cropped significantly from top and shifted upwards (Mobile enhanced shift, PC unchanged) -->
    <div class="absolute inset-x-0 -top-52 sm:-top-56 md:-top-44 h-[34%] sm:h-[42%] md:h-[68%] overflow-hidden">
      <Image
        src={content.shopImage}
        alt="EVERSHINE 店舗外観"
        class="w-full h-full object-cover object-[28%_bottom] md:object-[32%_bottom]"
        widths={[640, 1024, 1536, 2048]}
        sizes="100vw"
        quality={85}
        loading="lazy"
      />
      <!-- PC-only Dark Overlay (Strengthens desktop contrast while preserving mobile settings) -->
      <div class="hidden md:block absolute inset-0 bg-black/45 pointer-events-none"></div>
      <div class="hidden md:block absolute inset-0 bg-gradient-to-r from-black/50 via-black/20 to-transparent pointer-events-none"></div>

      <!-- Smooth fade out at the bottom of the image container -->
      <div class="absolute inset-x-0 bottom-0 h-32 sm:h-40 md:h-48 bg-gradient-to-t from-slate-950 to-transparent pointer-events-none"></div>
    </div>

    <!-- Mobile-only Top Dark Overlay (Ensures Title Visibility on Mobile, hidden on PC) -->
    <div class="md:hidden absolute inset-x-0 top-0 h-52 sm:h-64 bg-gradient-to-b from-black/90 via-black/60 to-transparent pointer-events-none"></div>

    <!-- Solid Black Fill at the Bottom (Mobile: expanded black fill, PC: unchanged) -->
    <div class="absolute inset-x-0 bottom-0 h-[68%] sm:h-[60%] md:h-[45%] bg-slate-950"></div>
  </div>

  <div
    class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-gold/30 to-transparent z-10"
  >
  </div>

  <div class="relative z-10 px-6 md:px-12 lg:px-20">
    <div class="max-w-7xl mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-52 sm:mb-56 md:mb-56 lg:mb-64">
        <div class="access-reveal flex items-center justify-center gap-5">
          <span class="w-12 md:w-16 h-px bg-gold/60 flex-shrink-0"></span>
          <h2 class="flex flex-col items-center gap-1.5 drop-shadow-[0_2px_10px_rgba(0,0,0,0.9)]">
            <span
              class="font-sans text-[clamp(1.8rem,4vw,3rem)] font-light tracking-[0.05em] text-white leading-tight"
            >
              {content.sectionLabelJa}
            </span>
            <span
              class="font-display text-sm sm:text-base md:text-[17px] tracking-[0.3em] text-gold uppercase leading-none font-bold"
            >
              {content.sectionLabel}
            </span>
          </h2>
          <span class="w-12 md:w-16 h-px bg-gold/60 flex-shrink-0"></span>
        </div>
      </div>

      <!-- Layout Container -->
      <div class="space-y-8 lg:space-y-10">
        
        <!-- Top Row: Company Info & Owner Photo (Balanced 2 Columns) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          
          <!-- Left: Company Info (7 Columns) -->
          <div class="access-reveal lg:col-span-7">
            <!-- Company Name -->
            <div class="mb-5 md:mb-7">
              <span
                class="font-display text-[clamp(1.55rem,6.8vw,2.75rem)] tracking-[0.02em] sm:tracking-[0.05em] text-white font-light whitespace-nowrap block"
              >
                {general.companyName}
              </span>
            </div>

            <!-- Info Items -->
            <address class="space-y-4 md:space-y-5 not-italic">
              <!-- Address -->
              <div class="flex gap-4 md:gap-6 items-start py-0.5">
                <div class="w-28 md:w-32 shrink-0 flex flex-col">
                  <span
                    class="font-sans text-lg sm:text-xl md:text-[22px] font-medium tracking-wider text-white leading-tight"
                  >
                    住所
                  </span>
                  <span
                    class="font-display text-[11px] md:text-xs tracking-[0.22em] text-gold uppercase leading-none mt-1.5 font-bold"
                  >
                    Address
                  </span>
                </div>
                <div>
                  <p
                    class="font-sans text-base sm:text-lg md:text-[17px] font-normal leading-[1.7] tracking-[0.04em] text-slate-200"
                  >
                    {general.zipCode}<br />
                    {general.address}
                  </p>
                </div>
              </div>

              <!-- Divider -->
              <div class="w-full h-px bg-white/10"></div>

              <!-- Access / Directions -->
              <div class="flex gap-4 md:gap-6 items-start py-0.5">
                <div class="w-28 md:w-32 shrink-0 flex flex-col">
                  <span
                    class="font-sans text-lg sm:text-xl md:text-[22px] font-medium tracking-wider text-white leading-tight"
                  >
                    アクセス
                  </span>
                  <span
                    class="font-display text-[11px] md:text-xs tracking-[0.22em] text-gold uppercase leading-none mt-1.5 font-bold"
                  >
                    Access
                  </span>
                </div>
                <div>
                  <p
                    class="font-sans text-base sm:text-lg md:text-[17px] font-normal leading-[1.7] tracking-[0.03em] text-slate-200"
                  >
                    {general.directions}
                  </p>
                </div>
              </div>

              <!-- Divider -->
              <div class="w-full h-px bg-white/10"></div>

              <!-- Phone -->
              <div class="flex gap-4 md:gap-6 items-start py-0.5">
                <div class="w-28 md:w-32 shrink-0 flex flex-col">
                  <span
                    class="font-sans text-lg sm:text-xl md:text-[22px] font-medium tracking-wider text-white leading-tight"
                  >
                    電話番号
                  </span>
                  <span
                    class="font-display text-[11px] md:text-xs tracking-[0.22em] text-gold uppercase leading-none mt-1.5 font-bold"
                  >
                    Tel
                  </span>
                </div>
                <div>
                  <a
                    href={general.phoneNumberRaw}
                    class="font-sans text-base sm:text-lg md:text-xl font-medium tracking-[0.03em] text-white hover:text-gold transition-colors duration-300"
                  >
                    {general.phoneNumber}
                  </a>
                </div>
              </div>

              <!-- Divider -->
              <div class="w-full h-px bg-white/10"></div>

              <!-- Hours -->
              <div class="flex gap-4 md:gap-6 items-start py-0.5">
                <div class="w-28 md:w-32 shrink-0 flex flex-col">
                  <span
                    class="font-sans text-lg sm:text-xl md:text-[22px] font-medium tracking-wider text-white leading-tight"
                  >
                    営業時間
                  </span>
                  <span
                    class="font-display text-[11px] md:text-xs tracking-[0.22em] text-gold uppercase leading-none mt-1.5 font-bold"
                  >
                    Hours
                  </span>
                </div>
                <div>
                  <p
                    class="font-sans text-base sm:text-lg md:text-[17px] font-normal tracking-[0.03em] text-slate-200"
                  >
                    {general.hours}
                  </p>
                  <p
                    class="font-sans text-sm sm:text-base font-normal tracking-[0.03em] text-slate-400 mt-1"
                  >
                    {general.holiday}
                  </p>
                </div>
              </div>

              <!-- Divider -->
              <div class="w-full h-px bg-white/10"></div>

              <!-- Parking / Access Note -->
              <div class="flex gap-4 md:gap-6 items-start py-0.5">
                <div class="w-28 md:w-32 shrink-0 flex flex-col">
                  <span
                    class="font-sans text-lg sm:text-xl md:text-[22px] font-medium tracking-wider text-white leading-tight"
                  >
                    駐車場
                  </span>
                  <span
                    class="font-display text-[11px] md:text-xs tracking-[0.22em] text-gold uppercase leading-none mt-1.5 font-bold"
                  >
                    Parking
                  </span>
                </div>
                <div>
                  <p
                    class="font-sans text-base sm:text-lg md:text-[17px] font-normal tracking-[0.03em] text-slate-200"
                  >
                    専用駐車スペース完備
                  </p>
                  <p
                    class="font-sans text-sm sm:text-base font-normal tracking-[0.03em] text-slate-400 mt-1"
                  >
                    お車でお越しの際はそのまま店舗前へお進みください。
                  </p>
                </div>
              </div>
            </address>
          </div>

          <!-- Right: Owner Photo & Name (5 Columns) -->
          <div class="access-reveal lg:col-span-5 flex justify-center lg:justify-end">
            <div class="w-full max-w-[280px] sm:max-w-[310px] md:max-w-[340px]">
              <!-- Owner Photo -->
              <div class="relative w-full overflow-hidden rounded-sm shadow-2xl shadow-black/60 border border-white/10">
                <Image
                  src={content.ownerImage}
                  alt={`${content.ownerRole} ${content.ownerName}`}
                  class="w-full h-auto object-cover block"
                  loading="lazy"
                />
              </div>
              <div class="mt-3 flex items-baseline justify-center gap-2.5 text-center">
                <span class="text-sm md:text-base text-slate-300 tracking-wider font-medium">{content.ownerRole}</span>
                <span class="text-base sm:text-lg md:text-xl font-medium tracking-wider text-white">{content.ownerName}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Bottom Row: Sleek Wide Google Map & Centered Open Button -->
        <div class="access-reveal space-y-4 sm:space-y-5">
          <div class="relative w-full h-[200px] sm:h-[240px] md:h-[280px] overflow-hidden rounded-sm bg-slate-900 border border-white/15 shadow-2xl shadow-black/50">
            <iframe
              src="https://maps.google.com/maps?q=EVERSHINE%20%E9%95%B7%E9%87%8E%E7%9C%8C%E5%A1%A9%E5%B0%BB%E5%B8%82%E5%BA%83%E4%B8%98%E5%A0%85%E7%9F%B32146-161&output=embed"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen={true}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="absolute inset-0 w-full h-full"
              title={content.mapTitle}></iframe>
          </div>

          <!-- Google Maps Button (Centered at Bottom) -->
          <div class="flex justify-center pt-1 sm:pt-2">
            <a
              href={content.googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 px-7 py-3 sm:px-9 sm:py-3.5 rounded-full border border-gold/40 bg-white/5 hover:bg-gold/15 hover:border-gold text-slate-100 hover:text-white transition-all duration-300 group shadow-lg shadow-black/40 text-sm sm:text-base font-sans tracking-widest font-medium"
            >
              <!-- Map Pin Icon -->
              <svg class="w-4 h-4 text-gold group-hover:scale-110 transition-transform duration-300 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>Googleマップで開く</span>
              <!-- Arrow Icon -->
              <svg
                width="12"
                height="12"
                viewBox="0 0 14 14"
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                class="transform transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 text-gold"
              >
                <path d="M1 13L13 1M13 1H5M13 1v8"></path>
              </svg>
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>

  <div
    class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-gold/30 to-transparent z-10"
  >
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray<HTMLElement>(".access-reveal").forEach((el, i) => {
    gsap.fromTo(
      el,
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: "power3.out",
        delay: i * 0.15,
        scrollTrigger: {
          trigger: el,
          start: "top 85%",
          toggleActions: "play none none none",
        },
      },
    );
  });
</script>
