---
import { siteSettings } from '../config/siteSettings';

const { whyUs } = siteSettings;
const { content, style } = whyUs;
---

<section id="why-us" class={`relative ${style.paddingY} overflow-hidden bg-gradient-to-b from-[#f8f5ee] via-[#faf7f2] to-[#f4eee4]`}>
  <!-- Background Ornamental Top/Bottom Lines -->
  <div class="section-border-line top-0"></div>
  <div class="section-border-line bottom-0"></div>

  <!-- Ambient Glow in Background -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-gold/[0.07] rounded-full blur-[150px] pointer-events-none"></div>

  <div class="px-6 md:px-12 lg:px-20 relative z-10">
    <div class="max-w-7xl mx-auto">
      
      <!-- Section Header -->
      <div class="text-center mb-10 md:mb-14 lg:mb-16">
        <div class="whyus-reveal flex items-center justify-center gap-5 mb-4">
          <span class="w-12 md:w-16 h-px bg-gold/60 flex-shrink-0"></span>
          <h2 class="flex flex-col items-center gap-1.5">
            <span class="font-sans text-[clamp(1.8rem,4vw,3rem)] font-light tracking-[0.05em] text-slate-900 leading-tight">
              {content.sectionLabelJa}
            </span>
            <span class="font-display text-sm sm:text-base md:text-[17px] tracking-[0.3em] text-gold uppercase leading-none font-bold">
              {content.sectionLabel}
            </span>
          </h2>
          <span class="w-12 md:w-16 h-px bg-gold/60 flex-shrink-0"></span>
        </div>
      </div>

      <!-- Monument Panels Grid (Responsive 1/2/3 cols based on settings or items count) -->
      <div class="relative">
        <div class={`grid grid-cols-1 ${content.strengths.length === 2 ? 'md:grid-cols-2' : 'md:grid-cols-3'} gap-6 lg:gap-8 xl:gap-10 relative`}>
          {content.strengths.map((item, index) => {
            return (
              <div class="whyus-card relative group">
                <!-- Monument Stage Panel -->
                <div class="relative h-full flex flex-col justify-between overflow-hidden rounded-sm border border-[#e5decb] bg-white/95 backdrop-blur-sm p-6 sm:p-7 md:p-8 lg:p-9 text-center transition-all duration-700 hover:border-gold hover:shadow-2xl hover:shadow-gold/[0.12] group-hover:-translate-y-1.5 shadow-lg shadow-[#8c6b2d]/[0.06]">
                  
                  <div>
                    <!-- Large Icon with subtle aura -->
                    <div class="mb-4 flex justify-center">
                      <div class="relative w-15 h-15 sm:w-16 sm:h-16 rounded-full border border-gold/30 bg-gold/[0.06] flex items-center justify-center text-gold-dark group-hover:border-gold/60 group-hover:bg-gold/[0.12] group-hover:scale-105 transition-all duration-500 shadow-md shadow-gold/5">
                        {index === 0 ? (
                          /* 実績・クラフトマンシップ (メダル・賞状) */
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" class="w-8 h-8 sm:w-8.5 sm:h-8.5 text-gold-dark group-hover:text-gold transition-colors duration-300">
                            <circle cx="12" cy="8" r="6" />
                            <path d="M15.47 13.5L19 21l-7-3-7 3 3.53-7.5" />
                          </svg>
                        ) : index === 1 ? (
                          /* 施工台数 (自動車) */
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" class="w-8 h-8 sm:w-8.5 sm:h-8.5 text-gold-dark group-hover:text-gold transition-colors duration-300">
                            <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 12 10s-6.7.6-8.5 1.1C2.7 11.3 2 12.1 2 13v3c0 .6.4 1 1 1h2" />
                            <circle cx="7" cy="17" r="2" />
                            <circle cx="17" cy="17" r="2" />
                            <path d="M5 10l1.5-4.5C6.8 4.6 7.7 4 8.7 4h6.6c1 0 1.9.6 2.2 1.5L19 10" />
                          </svg>
                        ) : (
                          /* 純水システム (水滴・輝き) */
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" class="w-8 h-8 sm:w-8.5 sm:h-8.5 text-gold-dark group-hover:text-gold transition-colors duration-300">
                            <path d="M12 2.5C12 2.5 5 10.5 5 15.5C5 19.366 8.134 22.5 12 22.5C15.866 22.5 19 19.366 19 15.5C19 10.5 12 2.5 12 2.5Z" />
                            <path d="M9.5 14.5C9.5 13 11 11.2 12.5 10.2" stroke-linecap="round" />
                          </svg>
                        )}
                      </div>
                    </div>

                    <!-- Monumental Display Number -->
                    <div class="mb-3 flex flex-col items-center">
                      <span
                        class="whyus-number font-display text-[clamp(3.5rem,6vw,5.5rem)] font-light text-gold-dark leading-none tracking-tight group-hover:text-gold transition-colors duration-500 tabular-nums"
                        data-value={item.number}
                      >
                        {item.number}
                      </span>
                      <span class="font-display text-sm md:text-base tracking-[0.22em] text-[#0b1a30] uppercase mt-2.5 block leading-none font-bold">
                        {item.unit}
                      </span>
                    </div>

                    <!-- Gold Horizontal Accent Line -->
                    <div class="w-10 h-px bg-gold mx-auto my-4 group-hover:w-20 transition-all duration-500 ease-out"></div>

                    <!-- Title (Japanese) -->
                    <h3 class="font-sans text-xl sm:text-2xl font-medium tracking-[0.08em] text-slate-900 mb-3 group-hover:text-gold-dark transition-colors duration-300">
                      {item.title}
                    </h3>

                    <!-- Description (Aligned across all cards) -->
                    <p class="font-sans text-sm md:text-base font-normal leading-[2.2] tracking-[0.04em] text-slate-700 mx-auto whitespace-pre-line">
                      {item.description}
                    </p>
                  </div>

                  <!-- Bottom Link Area (Anchored to bottom) -->
                  <div class="mt-4 min-h-[32px] flex items-center justify-center">
                    {item.hasModal && (
                      <button
                        type="button"
                        id="open-pure-water-modal"
                        class="group/link inline-flex items-center justify-center gap-1.5 text-xs sm:text-sm font-sans font-medium tracking-wider text-gold-dark hover:text-gold transition-all duration-300 cursor-pointer"
                        aria-haspopup="dialog"
                        aria-controls="pure-water-modal"
                      >
                        <span class="border-b border-gold/40 group-hover/link:border-gold pb-0.5 transition-colors duration-300">
                          {item.modalButtonLabel ? item.modalButtonLabel.replace(/＞$/, '') : '詳しく見る'}
                        </span>
                        <span class="inline-block transition-transform duration-300 group-hover/link:translate-x-1.5 text-gold-dark group-hover/link:text-gold font-normal text-xs">
                          ＞
                        </span>
                      </button>
                    )}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>

  <!-- Pure Water Detail Modal (案D: ポップアップモーダル) -->
  {content.pureWaterModal && (
    <div
      id="pure-water-modal"
      class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 opacity-0 pointer-events-none transition-opacity duration-300"
      role="dialog"
      aria-modal="true"
      aria-labelledby="pure-water-modal-title"
    >
      <!-- Backdrop Overlay -->
      <div
        id="pure-water-backdrop"
        class="absolute inset-0 bg-slate-950/75 backdrop-blur-sm transition-opacity duration-300 cursor-pointer"
      ></div>

      <!-- Modal Dialog Card -->
      <div
        id="pure-water-panel"
        class="relative w-full max-w-2xl max-h-[90vh] overflow-y-auto bg-white rounded-sm border border-gold/40 shadow-2xl shadow-slate-950/40 p-6 sm:p-8 md:p-10 transform scale-95 transition-transform duration-300"
      >
        <!-- Close Button -->
        <button
          type="button"
          id="close-pure-water-modal"
          class="absolute top-5 right-5 w-9 h-9 rounded-full bg-slate-100 hover:bg-gold/15 text-slate-500 hover:text-slate-900 border border-slate-200/80 hover:border-gold/50 flex items-center justify-center transition-all duration-300 cursor-pointer"
          aria-label="閉じる"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>

        <!-- Header -->
        <div class="mb-6 pr-8 pb-5 border-b border-slate-100">
          <h3 id="pure-water-modal-title" class="font-sans text-xl sm:text-2xl md:text-[1.65rem] font-medium text-slate-900 tracking-[0.03em] leading-[1.4] whitespace-pre-line">
            {content.pureWaterModal.title}
          </h3>
          <div class="w-20 sm:w-24 h-px bg-gold mt-3.5 mb-3"></div>
          <p class="font-sans text-sm sm:text-[15px] font-normal text-slate-600 leading-[2] tracking-wide">
            {content.pureWaterModal.intro}
          </p>
        </div>

        <!-- Comparison: 水道水 vs 純水 -->
        {content.pureWaterModal.comparison && (
          <div>
            <h4 class="font-sans text-base sm:text-[17px] font-bold text-slate-900 tracking-wide mb-3.5 pl-3 border-l-2 border-gold py-0.5">
              {content.pureWaterModal.comparison.sectionTitle || "純水と水道水の違い"}
            </h4>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 mb-3.5">
              <!-- 純水 -->
              <div class="p-4 sm:p-5 rounded-sm bg-gradient-to-br from-[#faf7f2] to-[#f4eee4] border border-gold/50 shadow-sm flex flex-col justify-between">
                <div>
                  <span class="inline-block font-sans text-xs font-bold tracking-wider text-[#0b1a30] mb-2">
                    {content.pureWaterModal.comparison.pureTitle}
                  </span>
                  <p class="text-xs sm:text-[13px] text-slate-800 leading-[1.9] font-normal">
                    {content.pureWaterModal.comparison.pureDesc}
                  </p>
                </div>
              </div>

              <!-- 水道水 -->
              <div class="p-4 sm:p-5 rounded-sm bg-slate-50 border border-slate-200/80 flex flex-col justify-between">
                <div>
                  <span class="inline-block font-sans text-xs font-bold tracking-wider text-slate-500 mb-2">
                    {content.pureWaterModal.comparison.tapTitle}
                  </span>
                  <p class="text-xs sm:text-[13px] text-slate-600 leading-[1.9] font-normal">
                    {content.pureWaterModal.comparison.tapDesc}
                  </p>
                </div>
              </div>
            </div>

            <!-- まとめテキスト（カード形式ではなく通常の文章として表示） -->
            {content.pureWaterModal.comparison.summary && (
              <p class="font-sans text-xs sm:text-[13.5px] text-slate-600 leading-[2] tracking-wide mt-3.5">
                {content.pureWaterModal.comparison.summary}
              </p>
            )}
          </div>
        )}

        <!-- 2つの小見出し間の区切り線 -->
        <div class="w-full h-px bg-slate-200 my-7 sm:my-8" aria-hidden="true"></div>

        <!-- Key Points (自宅で純水洗車をするメリット) -->
        {content.pureWaterModal.points && (
          <div class="mb-2">
            <h4 class="font-sans text-base sm:text-[17px] font-bold text-slate-900 tracking-wide mb-3 pl-3 border-l-2 border-gold py-0.5">
              {content.pureWaterModal.benefitsTitle || "自宅で純水洗車をするメリット"}
            </h4>

            {content.pureWaterModal.benefitsIntro && (
              <p class="font-sans text-xs sm:text-[13.5px] text-slate-600 leading-[2] tracking-wide mb-4">
                {content.pureWaterModal.benefitsIntro}
              </p>
            )}

            <div class="divide-y divide-slate-100">
              {content.pureWaterModal.points.map((point) => (
                <div class="py-4 first:pt-2 last:pb-0 flex gap-4 sm:gap-5 items-start">
                  <span class="font-display text-2xl sm:text-3xl text-gold-dark font-light leading-none shrink-0 mt-0.5 tabular-nums">
                    {point.number}
                  </span>
                  <div>
                    <h5 class="font-sans text-sm sm:text-base font-bold text-slate-900 mb-1 tracking-wide leading-snug">
                      {point.title}
                    </h5>
                    <p class="font-sans text-xs sm:text-sm font-normal text-slate-600 leading-[2] tracking-wide">
                      {point.description}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Footer Note (Optional) -->
        {content.pureWaterModal.footerNote && (
          <div class="pt-4 border-t border-slate-100 mt-6">
            <div class="bg-[#faf8f5] rounded-sm py-3 px-4 border border-gold/20 text-center">
              <p class="font-sans text-xs sm:text-[13px] text-slate-600 font-normal leading-relaxed tracking-wide">
                {content.pureWaterModal.footerNote}
              </p>
            </div>
          </div>
        )}
      </div>
    </div>
  )}
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Header reveal
  gsap.utils.toArray<HTMLElement>('.whyus-reveal').forEach((el) => {
    gsap.fromTo(
      el,
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: el,
          start: 'top 85%',
          toggleActions: 'play none none none',
        },
      }
    );
  });

  // Cards staggered entrance
  const cards = document.querySelectorAll<HTMLElement>('.whyus-card');
  if (cards.length > 0) {
    gsap.fromTo(
      cards,
      { opacity: 0, y: 40 },
      {
        opacity: 1,
        y: 0,
        duration: 1,
        stagger: 0.18,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: cards[0],
          start: 'top 85%',
          toggleActions: 'play none none none',
        },
      }
    );
  }

  // Count-up and scale animation for numbers
  const numberEls = document.querySelectorAll<HTMLElement>('.whyus-number');
  numberEls.forEach((el) => {
    const rawValue = el.getAttribute('data-value') || el.innerText.trim();
    const cleanDigits = rawValue.replace(/[^\d]/g, '');
    const targetNum = parseInt(cleanDigits, 10);
    const suffix = rawValue.replace(/[\d,]/g, '');
    const useComma = rawValue.includes(',');

    if (!isNaN(targetNum)) {
      const counter = { val: 0 };
      el.innerText = '0' + suffix;

      gsap.fromTo(
        el,
        { opacity: 0, scale: 0.85 },
        {
          opacity: 1,
          scale: 1,
          duration: 0.8,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: el,
            start: 'top 85%',
            toggleActions: 'play none none none',
            onEnter: () => {
              gsap.to(counter, {
                val: targetNum,
                duration: 2.0,
                ease: 'power3.out',
                onUpdate: () => {
                  const currentInt = Math.floor(counter.val);
                  const formatted = useComma
                    ? currentInt.toLocaleString('en-US')
                    : currentInt.toString();
                  el.innerText = formatted + suffix;
                },
                onComplete: () => {
                  const formatted = useComma
                    ? targetNum.toLocaleString('en-US')
                    : targetNum.toString();
                  el.innerText = formatted + suffix;
                }
              });
            }
          }
        }
      );
    }
  });

  // Pure Water Modal Interaction
  const openModalBtn = document.getElementById('open-pure-water-modal');
  const closeModalBtn = document.getElementById('close-pure-water-modal');
  const modal = document.getElementById('pure-water-modal');
  const backdrop = document.getElementById('pure-water-backdrop');
  const panel = document.getElementById('pure-water-panel');

  function openModal() {
    if (!modal || !panel) return;
    modal.classList.remove('opacity-0', 'pointer-events-none');
    modal.classList.add('opacity-100');
    panel.classList.remove('scale-95');
    panel.classList.add('scale-100');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    if (!modal || !panel) return;
    modal.classList.add('opacity-0', 'pointer-events-none');
    modal.classList.remove('opacity-100');
    panel.classList.add('scale-95');
    panel.classList.remove('scale-100');
    document.body.style.overflow = '';
  }

  openModalBtn?.addEventListener('click', openModal);
  closeModalBtn?.addEventListener('click', closeModal);
  backdrop?.addEventListener('click', closeModal);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('pointer-events-none')) {
      closeModal();
    }
  });
</script>
