---
import { Image } from 'astro:assets';
import { siteSettings } from '../config/siteSettings';

const { craftsmanship } = siteSettings;
const { content, style } = craftsmanship;
---

<section id="craftsmanship" class={`relative ${style.paddingY} overflow-hidden bg-gradient-to-b from-[#f8f5ee] via-[#faf7f2] to-[#f4eee4]`}>
  <!-- Background Ornamental Top/Bottom Lines -->
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-gold/30 to-transparent"></div>
  <div class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-gold/30 to-transparent"></div>

  <!-- Ambient Glow in Background -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-gold/[0.07] rounded-full blur-[150px] pointer-events-none"></div>

  <div class="px-6 md:px-12 lg:px-20 relative z-10">
    <div class="max-w-7xl mx-auto">
      
      <!-- Section Header & Hero Graphic Grid (左右2カラム構成) -->
      <div class="mb-14 md:mb-20 lg:mb-24">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 xl:gap-16 items-stretch">
          
          <!-- Left Column: 左寄せキャッチコピー & 本文 -->
          <div class="lg:col-span-7 xl:col-span-7 flex flex-col justify-center items-start text-left">
            <!-- Section Label (他セクションと完全に統一したヘッダー) -->
            <div class="craftsmanship-reveal flex items-center gap-5 mb-6 md:mb-8">
              <span class="w-12 md:w-16 h-px bg-gold/60 flex-shrink-0"></span>
              <div class="flex flex-col gap-1.5">
                <h2 class="font-sans text-[clamp(1.8rem,4vw,3rem)] font-light tracking-[0.05em] text-slate-900 leading-tight">
                  {content.sectionLabelJa}
                </h2>
                <span class="font-display text-sm sm:text-base md:text-[17px] tracking-[0.3em] text-gold uppercase leading-none font-bold">
                  {content.sectionLabel}
                </span>
              </div>
            </div>

            <!-- Catchphrase / Heading (左寄せ) -->
            <h3 class="craftsmanship-reveal text-left space-y-2 sm:space-y-3">
              <span class={`block font-display ${style.headingSize || 'text-[clamp(1.35rem,3.4vw,3.2rem)]'} font-light tracking-[0.02em] text-slate-900 leading-[1.25] whitespace-nowrap`}>
                {content.headingLine1}
              </span>
              <span class={`block font-display ${style.headingSize || 'text-[clamp(1.35rem,3.4vw,3.2rem)]'} font-light tracking-[0.02em] text-slate-900 leading-[1.25] whitespace-nowrap`}>
                {content.headingLine2}
              </span>
              <span class={`block font-display ${style.headingSize || 'text-[clamp(1.35rem,3.4vw,3.2rem)]'} font-light tracking-[0.02em] text-slate-900 leading-[1.25] whitespace-nowrap`}>
                <span class="text-gold-dark font-normal">{content.headingLine3 || 'EVERSHINE加工'}</span>
              </span>
            </h3>

            <!-- Gold Divider Accent -->
            <div class="craftsmanship-reveal w-16 h-[2px] bg-gradient-to-r from-gold to-transparent my-6 md:my-7"></div>

            <!-- Lead Text / 本文 (左寄せ) -->
            {content.leadText && (
              <p class="craftsmanship-reveal font-sans text-sm sm:text-base lg:text-[1.05rem] font-normal leading-[2.2] md:leading-[2.3] tracking-[0.04em] text-slate-700 text-left whitespace-pre-line [word-break:auto-phrase]">
                {content.leadText}
              </p>
            )}
          </div>

          <!-- Right Column: Craftsmanship.png (下までしっかり伸びる左倒し台形) -->
          <div class="lg:col-span-5 xl:col-span-5 relative w-full craftsmanship-reveal mt-6 lg:mt-0 flex flex-col">
            <div class="relative w-full h-full min-h-[360px] sm:min-h-[440px] lg:min-h-[520px] xl:min-h-[560px] group [filter:drop-shadow(0_15px_25px_rgba(0,0,0,0.12))]">
              <!-- Slanted Trapezoid Container (左に倒れた台形) -->
              <div class="w-full h-full [clip-path:polygon(10%_0,_100%_0,_90%_100%,_0%_100%)] lg:[clip-path:polygon(18%_0,_100%_0,_82%_100%,_0%_100%)] overflow-hidden relative rounded-sm">
                {content.heroImage && (
                  <Image
                    src={content.heroImage}
                    alt="EVERSHINE こだわりの施工クラフトマンシップ"
                    class="w-full h-full object-cover object-center scale-110 transition-transform duration-[1.5s] ease-out group-hover:scale-120"
                    widths={[600, 900, 1200, 1600]}
                    sizes="(max-width: 1024px) 100vw, 45vw"
                    quality={90}
                    loading="lazy"
                  />
                )}
                <!-- Ambient Subtle Gradient Overlay -->
                <div class="absolute inset-0 bg-gradient-to-tr from-black/25 via-transparent to-transparent pointer-events-none"></div>
              </div>

              <!-- Slanted Gold Border Outline on Trapezoid (台形のゴールド枠線) -->
              <div 
                class="absolute inset-0 pointer-events-none"
                aria-hidden="true"
              >
                <svg class="w-full h-full absolute inset-0 preserve-3d" preserveAspectRatio="none" viewBox="0 0 100 100">
                  <!-- スマホ用の台形線 -->
                  <polygon class="lg:hidden" points="10,0 100,0 90,100 0,100" fill="none" stroke="#d4af37" stroke-width="0.75" stroke-opacity="0.6" vector-effect="non-scaling-stroke" />
                  <!-- PC用の台形線 -->
                  <polygon class="hidden lg:block" points="18,0 100,0 82,100 0,100" fill="none" stroke="#d4af37" stroke-width="0.75" stroke-opacity="0.6" vector-effect="non-scaling-stroke" />
                </svg>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- Process Diagram Visual (アートピース・ミニマル図解) -->
      {content.processDiagram && (
        <div class="craftsmanship-reveal my-12 md:my-20">
          <div class="relative py-10 md:py-14">
            <!-- Subtle Top/Bottom Fine Gold Lines -->
            <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-gold/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-gold/40 to-transparent"></div>

            <!-- Header label for diagram -->
            <div class="text-center mb-8 md:mb-10">
              <h3 class="font-sans text-2xl sm:text-3xl md:text-[32px] font-normal tracking-[0.04em] text-slate-900 leading-snug">
                {content.processDiagram.title}
              </h3>
              <div class="w-12 h-px bg-gold/50 mx-auto mt-4"></div>
            </div>

            <!-- White Card Presentation for Diagram Graphic -->
            <div class="max-w-4xl mx-auto px-2 sm:px-4">
              <div class="relative group bg-white rounded-sm border border-slate-200/80 p-5 sm:p-8 md:p-10 shadow-xl shadow-slate-900/5 transition-all duration-500 hover:border-gold/40">
                <Image
                  src={content.processDiagram.image}
                  alt={content.processDiagram.imageAlt}
                  class="w-full h-auto max-h-[420px] object-contain mx-auto transition-transform duration-700 ease-out group-hover:scale-[1.01]"
                  widths={[600, 900, 1200, 1600]}
                  quality={95}
                />
              </div>
            </div>

            <!-- Editorial Caption -->
            {content.processDiagram.description && (
              <p class="font-sans text-sm sm:text-base text-slate-700 font-normal leading-[2.2] tracking-wide text-center max-w-2xl mx-auto mt-6 md:mt-8 px-4 whitespace-pre-line">
                {content.processDiagram.description}
              </p>
            )}
          </div>
        </div>
      )}

      <!-- Features Section Header -->
      {content.featuresTitle && (
        <div class="craftsmanship-reveal text-center mt-12 md:mt-16 mb-8 md:mb-12">
          <h3 class="font-sans text-2xl sm:text-3xl md:text-[32px] font-normal tracking-[0.04em] text-slate-900 leading-snug">
            {content.featuresTitle.includes('6つの特徴') ? (
              <>
                {content.featuresTitle.split('6つの特徴')[0]}
                <span class="text-gold-dark font-medium">6つの特徴</span>
                {content.featuresTitle.split('6つの特徴')[1]}
              </>
            ) : (
              content.featuresTitle
            )}
          </h3>
          <div class="w-12 h-px bg-gold/50 mx-auto mt-4"></div>
        </div>
      )}

      <!-- Features Typographic Editorial Layout (サイト全体と調和した高品位タイポグラフィ) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 lg:gap-x-16 gap-y-8 md:gap-y-10 my-4 md:my-8">
        {content.features.map((feature, index) => (
          <div class="feature-item group relative pt-6 sm:pt-7 border-t border-gold/25 transition-all duration-500 hover:border-gold/50">
            <div class="flex items-start gap-4 sm:gap-5">
              <!-- Artistic Display Number & Fine Accent Line -->
              <div class="flex flex-col items-start shrink-0">
                <span class="font-display text-4xl sm:text-5xl lg:text-[48px] font-light text-gold-dark group-hover:text-gold transition-colors duration-500 tabular-nums leading-none tracking-tight">
                  {feature.number}
                </span>
                <span class="w-6 h-px bg-gold/40 group-hover:w-12 group-hover:bg-gold transition-all duration-500 mt-2.5"></span>
              </div>

              <!-- Typographic Text Composition -->
              <div class="flex-1 min-w-0 pt-0.5">
                <!-- Japanese Title (Harmonized with site headings) -->
                <h4 class="font-sans text-lg sm:text-xl font-medium tracking-[0.03em] text-slate-900 group-hover:text-gold-dark transition-colors duration-300 leading-snug mb-2.5">
                  {feature.title}
                </h4>

                <!-- Description (Harmonized with site body text) -->
                <p class="font-sans text-sm sm:text-[15px] font-normal leading-[2.2] tracking-wide text-slate-600 group-hover:text-slate-700 transition-colors duration-300 whitespace-pre-line">
                  {feature.description}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Bottom Philosophy Message Banner -->
      {content.bottomMessage && (
        <div class="craftsmanship-reveal relative overflow-hidden bg-white/90 border border-gold/30 rounded-sm p-6 sm:p-8 md:p-10 text-center shadow-md mt-8 md:mt-12">
          <div class="absolute top-0 left-1/2 -translate-x-1/2 w-24 h-px bg-gold"></div>
          <p class="font-display text-lg sm:text-xl md:text-2xl text-slate-900 font-light tracking-wide leading-relaxed">
            {content.bottomMessage}
          </p>
          <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-24 h-px bg-gold"></div>
        </div>
      )}

    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Header & lead reveal
  gsap.utils.toArray<HTMLElement>('.craftsmanship-reveal').forEach((el) => {
    gsap.fromTo(
      el,
      { opacity: 0, y: 35 },
      {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: el,
          start: 'top 88%',
          toggleActions: 'play none none none',
        },
      }
    );
  });

  // Feature items staggered reveal
  const items = gsap.utils.toArray<HTMLElement>('.feature-item');
  items.forEach((item, i) => {
    gsap.fromTo(
      item,
      {
        opacity: 0,
        y: 20,
      },
      {
        opacity: 1,
        y: 0,
        duration: 0.6,
        ease: 'power3.out',
        delay: (i % 2) * 0.1,
        scrollTrigger: {
          trigger: item,
          start: 'top 92%',
          toggleActions: 'play none none none',
        },
      }
    );
  });
</script>
